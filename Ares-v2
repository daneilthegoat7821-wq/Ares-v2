            end
        end
        if app.v("cb_hitlogs") then
            local rows={};local maxrows=numeric("cb_log_rows",5,3,10)
            for i=#C.logs,math.max(1,#C.logs-maxrows+1),-1 do
                local row=C.logs[i]
                if now-row.time<=numeric("cb_log_life",6,2,15) then
                    rows[#rows+1]={row.name,string.format("-%d HP%s / correlated",row.amount,row.kill and " / down" or ""),ui.colors._hitlog or theme.accent}
                end
            end
            if #rows==0 then rows={{"Waiting for local fire","HP observed"}} end
            app.panel("hitlogs","HIT LOGS / HP OBSERVED",rows,340)
        end
    end
end


-- Client observations are review signals. Account age alone never flags a player.
do
    local entries,order={},{}
    local scan_index,cleanup_index,next_poll,last_time=1,1,0,0
    local enabled=false
    local S={state="Off",revision=0,retained=0,flagged=0,young=0,polls=0,checks=0,
        kill_source="Unavailable",attributed_kills=0,unattributed_deaths=0}
    local function read(o,k)
        if o==nil then return nil end
        local ok,v=pcall(function() return o[k] end)
        if ok then return v end
    end
    local function finite(v) return type(v)=="number" and v==v and math.abs(v)<math.huge end
    local function xyz(v)
        local x,y,z=read(v,"X"),read(v,"Y"),read(v,"Z")
        if finite(x) and finite(y) and finite(z) then return x,y,z end
    end
    local function uid(p)
        local n=read(p,"UserId")
        if finite(n) and n>0 and n<9007199254740992 and n==math.floor(n) then return n end
    end
    local function text(v,fallback)
        if type(v)~="string" or v=="" then return fallback end
        return v:gsub("[%c]"," "):sub(1,64)
    end
    local function number(key,default,lo,hi)
        local n=app.n(key)
        if not finite(n) then n=default end
        return math.max(lo,math.min(hi,n))
    end
    local function address(o)
        local n=read(o,"Address")
        if finite(n) and n>0 then return n end
    end
    local function speed_reset(e)
        e.x=nil;e.y=nil;e.z=nil;e.sample_time=nil;e.speed_since=nil;e.current_speed=nil
    end
    local function recount()
