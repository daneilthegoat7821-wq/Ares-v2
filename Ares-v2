-- File-I/O fallback through the documented utility.HttpGet API and local store.
local profile_http_token="1071150dc21b5e5590df2e0f9540fbde89fed94954e14fe5"
local profile_http_base="http://127.0.0.1:18753"
function app.ui_image_fallback(key,revision)
    return profile_http_base.."/v1/image/"..key..".png?token="..profile_http_token.."&rev="..revision
end
local function profile_urlencode(value)
    return (tostring(value):gsub("([^%w%-%._~])",function(char) return string.format("%%%02X",string.byte(char)) end))
end
local function profile_http_request(path,query)
    if not utility or type(utility.HttpGet)~="function" then return nil,"utility.HttpGet is unavailable" end
    local url=profile_http_base..path.."?token="..profile_http_token..(query or "")
    if #url>60000 then return nil,"Profile exceeds local HTTP request limit" end
    local ok,body,status=pcall(utility.HttpGet,url)
    if not ok then return nil,"Local config store connection failed" end
    if type(body)~="string" or tonumber(status)~=200 then
        return nil,"Local config store: "..tostring(status or "no response").." / "..tostring(body or "start the config-store helper")
    end
    return body
end
function app.account_http(ids)
    if type(ids)~="string" or #ids>300 or not ids:match("^%d[%d,]*$") then return nil,"Invalid account IDs" end
    return profile_http_request("/v1/accounts","&ids="..ids)
end
function app.connect_profile_store(force)
    if app.profile_backend and not force then return true end
    local health,err=profile_http_request("/v1/health")
    if not health or health:sub(1,9)~="DNSTORE1\n" then
        app.profile_http_error=err or "Unexpected local config-store response"
        return false,app.profile_http_error
    end
    local directory=health:sub(10)
    if directory=="" then return false,"Config store returned no folder" end
    local override=DELTA_NOVA_CONFIG_DIR
    if type(override)=="string" and override:gsub("\\","/"):gsub("/+$",""):lower()~=directory:lower() then
        return false,"Local helper folder differs from DELTA_NOVA_CONFIG_DIR"
    end
    local backend={name="Local disk / HTTP helper"}
    backend.read=function(path)
        local name=path:match("([^/\\]+)$")
        if not name then return nil,"Invalid profile path" end
        return profile_http_request("/v1/read","&file="..profile_urlencode(name))
    end
    backend.write=function(path,contents)
        local name=path:match("([^/\\]+)$")
        if not name then return nil,"Invalid profile path" end
        local body,message=profile_http_request("/v1/write","&file="..profile_urlencode(name).."&data="..profile_urlencode(contents))
        if not body then return nil,message end
        if body:sub(1,3)~="OK " then return nil,"Config store did not confirm the write" end
        return true
    end
    local registered,register_error=app.profile_register_backend(backend,directory)
    if not registered then
        app.profile_http_error=tostring(register_error or "Config-store backend registration failed")
        return false,app.profile_http_error
    end
    app.profile_http_error=nil
    return true
end
