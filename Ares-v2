function app.action(id)
    if id=="recoil_rescan" then
        app.pd_weapon_service(true); app.toast("Recoil rescan started"); return true
    elseif id=="recoil_report" then return app.recoil_diagnostics() end
    return previous_recoil_action(id)
end
