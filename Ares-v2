local function pd_weapon_children(object)
    if not pd_weapon_valid(object) then return {} end
    local ok,children=pcall(function() return object:GetChildren() end)
    if ok and type(children)=="table" then return children end
    return {}
end
local function pd_weapon_find(object,name)
    if not object then return nil end
    local ok,child=pcall(function() return object:FindFirstChild(name) end)
    if ok and pd_weapon_valid(child) then return child end
end
local function pd_weapon_identity(object)
    return tostring(pd_weapon_read(object,"Address") or object)
end
local function pd_weapon_roots(definition)
    local roots,seen={},{}
    for _,name in ipairs({"RecoilPattern","RecoilPatternDisabled"}) do
        local root=pd_weapon_find(definition,name)
        if root then
            local id=pd_weapon_identity(root)
            if not seen[id] then seen[id]=true;roots[#roots+1]=root end
        end
    end
    return roots
end

-- Observe only the source-known ViewModel/Item/SelfRef ObjectValue. A candidate
-- is accepted only after a budgeted read finds numeric pattern grandchildren.
local function pd_viewmodel_candidate()
    local workspace=pd_weapon_read(game,"Workspace")
    local camera=pd_weapon_read(workspace,"CurrentCamera") or pd_weapon_find(workspace,"Camera")
    local viewmodel=pd_weapon_find(camera,"ViewModel") or pd_weapon_find(workspace,"ViewModel")
    local candidate=pd_weapon_read(pd_weapon_find(pd_weapon_find(viewmodel,"Item"),"SelfRef"),"Value")
    if not pd_weapon_valid(candidate) then return nil end
    local roots=pd_weapon_roots(candidate)
    if #roots==0 then return nil end
    return candidate,roots
end

-- PD does not always expose its equipped weapon as a Character Tool. This is
-- the same replicated EquippedTool source used by the reference's loadout.
-- Return a display name first, then an identity stable for that equipped value.
function app.pd_equipped_tool()
    local me=app.me
    if not me and entity and type(entity.GetLocalPlayer)=="function" then
        local ok,value=pcall(entity.GetLocalPlayer); if ok then me=value end
    end
    local player_name=pd_weapon_read(me,"Name") or pd_weapon_read(pd_weapon_read(game,"LocalPlayer"),"Name")
    if type(player_name)~="string" or player_name=="" then return nil,nil end
    local rep=pd_weapon_read(game,"ReplicatedStorage")
    local data=pd_weapon_find(pd_weapon_find(rep,"Players"),player_name)
    local gv=pd_weapon_find(pd_weapon_find(data,"Status"),"GameplayVariables")
        or pd_weapon_find(data,"GameplayVariables")
    local equipped=pd_weapon_find(gv,"EquippedTool")
    local value=pd_weapon_read(equipped,"Value")
    local name=type(value)=="string" and value or pd_weapon_read(value,"Name")
    if type(name)~="string" or name=="" or name=="None" or name=="nil" then return nil,nil end
    local value_id=type(value)=="string" and name or pd_weapon_identity(value)
    return name,pd_weapon_identity(equipped)..":"..tostring(value_id)..":"..name
end

local function pd_equipped_sampled(now,force)
    if force or now-pd_equipped_sample.time>=0.1 then
        pd_equipped_sample.name,pd_equipped_sample.id=app.pd_equipped_tool()
        local candidate,roots=pd_viewmodel_candidate()
        local candidate_id=candidate and pd_weapon_identity(candidate)
        local root_ids={}
        for _,root in ipairs(roots or {}) do root_ids[#root_ids+1]=pd_weapon_identity(root) end
        local root_signature=table.concat(root_ids,":")
        local probe=pd_equipped_sample.probe
        if candidate then
            if not probe or probe.id~=candidate_id or probe.root_signature~=root_signature
                or (probe.done and not probe.valid and now-probe.time>=8) then
                probe={object=candidate,id=candidate_id,root_signature=root_signature,roots=roots,
                    root_index=1,stage="root",done=false,valid=false,time=now}
                pd_equipped_sample.probe=probe
            end
        else pd_equipped_sample.probe=nil end
        local ranged=pd_weapon_find(pd_weapon_read(game,"ReplicatedStorage"),"RangedWeapons")
        pd_equipped_sample.fallback=pd_equipped_sample.name and pd_weapon_find(ranged,pd_equipped_sample.name)
        pd_equipped_sample.time=now
    end
    return pd_equipped_sample.name,pd_equipped_sample.id
end
local function pd_definition_selected()
    local probe=pd_equipped_sample.probe
    if probe and probe.done and probe.valid and pd_weapon_valid(probe.object) then
        return probe.object,"ViewModel/Item/SelfRef",pd_weapon_read(probe.object,"Name"),probe.id
    end
    local definition=pd_equipped_sample.fallback
    if pd_weapon_valid(definition) then
        return definition,"ReplicatedStorage/RangedWeapons",pd_weapon_read(definition,"Name"),pd_weapon_identity(definition)
    end
end
function app.pd_equipped_definition()
    pd_equipped_sampled(utility.GetTime(),true)
    return pd_definition_selected()
end
local function pd_probe_step(probe,budget)
    local visits=0
    while not probe.done and visits<budget do
        if probe.stage=="root" then
            local root=probe.roots[probe.root_index]
            if not root then probe.done=true;break end
            probe.root_index=probe.root_index+1
            probe.patterns=pd_weapon_children(root);probe.pi=1;probe.stage="pattern"
        elseif probe.stage=="pattern" then
            local pattern=probe.patterns[probe.pi]
            if not pattern then probe.stage="root"
            else
                visits=visits+1;probe.pi=probe.pi+1
                probe.values=pd_weapon_children(pattern);probe.vi=1;probe.stage="value"
            end
        else
            local value=probe.values[probe.vi]
            if not value then probe.stage="pattern"
            else
                visits=visits+1;probe.vi=probe.vi+1
                if pd_weapon_valid(value) and pd_weapon_number(pd_weapon_read(value,"Value")) then
                    probe.valid=true;probe.done=true
                end
            end
        end
    end
    return visits
end
function app.pd_observation_resolve(budget)
    pd_equipped_sampled(utility.GetTime(),false)
    local probe=pd_equipped_sample.probe
    if probe and not probe.done then return pd_probe_step(probe,math.max(0,math.min(64,budget or 64))) end
    return 0
end
function app.pd_equipped_tool_sampled(force)
    return pd_equipped_sampled(utility.GetTime(),force)
end
local function pd_weapon_equal(a,b)
    return pd_weapon_number(a) and pd_weapon_number(b)
        and math.abs(a-b)<=math.max(0.00001,math.abs(b)*0.00001)
end
local function pd_weapon_restore(entry)
    if not pd_weapon_valid(entry.object) then
        local bucket=entry.definition_id and pd_recoil_definitions[entry.definition_id]
        if bucket then
            bucket.entries[entry.id]=nil
            if not next(bucket.entries) then pd_recoil_definitions[entry.definition_id]=nil end
        end
        pd_recoil_originals[entry.id]=nil
        return
    end
    entry.object.Value=entry.original
    if not pd_weapon_equal(pd_weapon_read(entry.object,"Value"),entry.original) then
        error("Recoil restore readback differs: "..entry.id)
    end
    local bucket=entry.definition_id and pd_recoil_definitions[entry.definition_id]
    if bucket then
        bucket.entries[entry.id]=nil
        if not next(bucket.entries) then pd_recoil_definitions[entry.definition_id]=nil end
    end
    pd_recoil_originals[entry.id]=nil
end
local function pd_weapon_restore_entry(entry)
    local ok,err
    if type(app.restore)=="function" and app.originals[entry.tag] then
        ok,err=pcall(app.restore,entry.tag)
    else
        ok,err=pcall(pd_weapon_restore,entry)
        if ok then app.originals[entry.tag]=nil end
    end
    return ok,err
end

function app.pd_weapon_cleanup(reason)
    if type(app.weapon_observation_cancel)=="function" then app.weapon_observation_cancel("Feature cleanup") end
    local pending,failures={},0
    for _,entry in pairs(pd_recoil_originals) do pending[#pending+1]=entry end
    local s=app.pd_weapon_status
    s.error=nil
    for _,entry in ipairs(pending) do
        local ok,err=pd_weapon_restore_entry(entry)
        if not ok then failures=failures+1; s.error=tostring(err) end
    end
    s.enabled=false; s.verified=0; s.pending=failures; s.failed=failures
    s.held_observed=nil
    s.status=failures>0 and "Restore pending" or (reason or "Off")
    s.scanning=false; s.complete=false; s.frame_visits=0
    pd_recoil_signature=nil; pd_recoil_cursor=nil; pd_recoil_completed_at=-100
    pd_recoil_equipped_id=nil; pd_recoil_root_id=nil;pd_recoil_definition_id=nil
    pd_equipped_sample={time=-100,name=nil,id=nil}
    return failures==0,s.error
end

local function pd_weapon_apply(value,reduction,weapon_name,pattern_name,definition_id,root_name)
    local current=pd_weapon_read(value,"Value")
    if not pd_weapon_number(current) then return false,"not numeric" end
    local id=pd_weapon_identity(value)
    local entry=pd_recoil_originals[id]
    if entry and not pd_weapon_valid(entry.object) then
        app.originals[entry.tag]=nil; pd_recoil_originals[id]=nil; entry=nil
    end
    if not entry then
        entry={id=id,object=value,original=current,tag=PD_RECOIL_TAG..id}
        pd_recoil_originals[id]=entry
        -- All normal cleanup paths (profiles, panic, calibration, shutdown) use
        -- this same per-instance restoration record.
        app.originals[entry.tag]={owner=id,value=current,write=function()
            pd_weapon_restore(entry)
        end}
    end
    if entry.definition_id~=definition_id then
        local old=entry.definition_id and pd_recoil_definitions[entry.definition_id]
        if old then old.entries[id]=nil end
        if definition_id then
            local bucket=pd_recoil_definitions[definition_id]
            if not bucket then bucket={ids={},entries={}};pd_recoil_definitions[definition_id]=bucket end
            if not bucket.entries[id] then bucket.ids[#bucket.ids+1]=id end
            bucket.entries[id]=entry
        end
    end
    entry.weapon=weapon_name; entry.pattern=pattern_name
    entry.definition_id=definition_id;entry.root=root_name
    local target=entry.original*(1-reduction/100)
    if not pd_weapon_equal(current,target) then
        local ok,err=pcall(function() value.Value=target end)
        if not ok then return false,tostring(err) end
    end
    if not pd_weapon_equal(pd_weapon_read(value,"Value"),target) then
        return false,"Recoil value write did not hold"
    end
    entry.applied=target
    return true
end

-- Shared, cheap source context for the input observer. Unlike the manual public
-- lookup, this honors the same 100 ms source cache as recoil maintenance.
function app.pd_observation_context()
    local held,equipped_id=pd_equipped_sampled(utility.GetTime(),false)
    local definition,source,name,id=pd_definition_selected()
    local char=pd_weapon_read(app.me,"Character")
    return {held=held,equipped_id=equipped_id,definition=definition,source=source,
        name=name,id=id,owner=char and pd_weapon_identity(char) or nil}
end
function app.pd_observation_begin(context,repair)
    if not context or not context.definition or not context.id then return nil end
    local percent=tonumber(app.v("bs_recoil_reduction")) or 100
    percent=math.max(0,math.min(100,percent))
    local bucket=pd_recoil_definitions[context.id]
    local has_entries=bucket and next(bucket.entries)~=nil
    return {context=context,repair=repair==true,reduction=percent,started=utility.GetTime(),
        bucket=has_entries and bucket or nil,index=1,mode=has_entries and "captured held values" or "uncaptured held instance sample",
        roots=not has_entries and pd_weapon_roots(context.definition) or nil,root_index=1,stage="root",
        done=false,checked=0,matched_before=0,matched_after=0,mismatched=0,unmapped=0,
        attempts=0,verified_writes=0,failed=0,visits=0,samples={},partial=false}
end
local function pd_observe_value(job,object,entry,path)
    if not pd_weapon_valid(object) then job.failed=job.failed+1;return end
    local current=pd_weapon_read(object,"Value")
    if not pd_weapon_number(current) then return end
    job.checked=job.checked+1
    local target=entry and entry.original*(1-job.reduction/100) or nil
    local matches=entry and pd_weapon_equal(current,target) or false
    if entry then
        if matches then job.matched_before=job.matched_before+1 else job.mismatched=job.mismatched+1 end
    else job.unmapped=job.unmapped+1 end
    local after=current
    if job.repair and entry and not matches and app.v("bs_no_recoil")==true then
        job.attempts=job.attempts+1
        local ok=pcall(function() object.Value=target end)
        after=pd_weapon_read(object,"Value")
        if ok and pd_weapon_equal(after,target) then
            job.verified_writes=job.verified_writes+1;entry.applied=target
        else job.failed=job.failed+1 end
    end
    if entry and pd_weapon_equal(after,target) then job.matched_after=job.matched_after+1 end
    if #job.samples<16 then
        job.samples[#job.samples+1]={path=path,id=pd_weapon_identity(object),
            original=entry and entry.original or nil,target=target,before=current,after=after,
            captured=entry~=nil,write_attempted=job.repair and entry~=nil and not matches,
            matches_after=entry~=nil and pd_weapon_equal(after,target)}
    end
end
function app.pd_observation_step(job,budget)
    if not job or job.done then return 0 end
    budget=math.max(0,math.min(64,math.floor(tonumber(budget) or 64)))
    local visits=0
    while visits<budget and not job.done do
        if job.bucket then
            local id=job.bucket.ids[job.index]
            if not id then job.done=true;break end
            job.index=job.index+1;visits=visits+1
            local entry=job.bucket.entries[id]
            if entry and entry.definition_id==job.context.id then
                pd_observe_value(job,entry.object,entry,tostring(entry.root).."/"..tostring(entry.pattern).."/"..tostring(pd_weapon_read(entry.object,"Name")))
            end
        elseif job.checked>=24 then job.partial=true;job.done=true
        elseif job.stage=="root" then
            local root=job.roots[job.root_index]
            if not root then job.done=true;break end
            job.root_index=job.root_index+1;job.root_name=pd_weapon_read(root,"Name")
            job.patterns=pd_weapon_children(root);job.pi=1;job.stage="pattern"
        elseif job.stage=="pattern" then
            local pattern=job.patterns[job.pi]
            if not pattern then job.stage="root"
            else
                visits=visits+1;job.pi=job.pi+1;job.pattern_name=pd_weapon_read(pattern,"Name")
                job.values=pd_weapon_children(pattern);job.vi=1;job.stage="value"
            end
        else
            local object=job.values[job.vi]
            if not object then job.stage="pattern"
            else
                visits=visits+1;job.vi=job.vi+1
                pd_observe_value(job,object,nil,tostring(job.root_name).."/"..tostring(job.pattern_name).."/"..tostring(pd_weapon_read(object,"Name")))
            end
        end
    end
    job.visits=job.visits+visits
    if job.done then
        job.completed=utility.GetTime()
        job.partial=job.partial or app.pd_weapon_status.scanning or (job.bucket~=nil and job.checked<app.pd_weapon_status.held_numeric)
        if job.context.id==pd_recoil_definition_id then
            app.pd_weapon_status.held_observed={time=job.completed,checked=job.checked,
                matched_before=job.matched_before,matched_after=job.matched_after,mismatched=job.mismatched,
                attempts=job.attempts,verified_writes=job.verified_writes,failed=job.failed,partial=job.partial,
                definition_id=job.context.id,owner=job.context.owner,reduction=job.reduction}
            if job.bucket and job.checked==app.pd_weapon_status.held_numeric then
                app.pd_weapon_status.held_verified=job.matched_after
            end
        end
    end
    return visits
end

-- Manual evidence only: sample the values captured by the adapter without
-- patching, restoring, rescanning the hierarchy, or claiming gun-side effects.
function app.pd_weapon_readback()
    local held=app.pd_equipped_tool()
    local definition,source,definition_name,definition_id=app.pd_equipped_definition()
    local result={behavior="UNVERIFIED",held=held,captured=0,readable=0,matches=0,
        changed=0,nonzero_originals=0,held_captured=0,held_matches=0,samples={},
        held_definition=definition_name,held_definition_id=definition_id,held_source=source}
    local rows={}
    for _,entry in pairs(pd_recoil_originals) do
        result.captured=result.captured+1
        local current=pd_weapon_read(entry.object,"Value")
        local readable=pd_weapon_valid(entry.object) and pd_weapon_number(current)
        local matches=readable and pd_weapon_equal(current,entry.applied)
        if readable then result.readable=result.readable+1 end
        if matches then result.matches=result.matches+1 else result.changed=result.changed+1 end
        if entry.original~=0 then result.nonzero_originals=result.nonzero_originals+1 end
        local is_held=definition_id~=nil and entry.definition_id==definition_id
        if is_held then
            result.held_captured=result.held_captured+1
            if matches then result.held_matches=result.held_matches+1 end
        end
        rows[#rows+1]={weapon=entry.weapon,pattern=entry.pattern,name=pd_weapon_read(entry.object,"Name"),
            id=entry.id,original=entry.original,target=entry.applied,current=current,
            readable=readable,matches=matches,held=is_held,root=entry.root,definition_id=entry.definition_id}
    end
    table.sort(rows,function(left,right)
        if left.held~=right.held then return left.held end
        return tostring(left.weapon)..":"..tostring(left.pattern)..":"..left.id
            <tostring(right.weapon)..":"..tostring(right.pattern)..":"..right.id
    end)
    for index=1,math.min(12,#rows) do result.samples[index]=rows[index] end
    return result
end

function app.pd_weapon_service(force)
    local s=app.pd_weapon_status
    local now=utility.GetTime()
    local enabled=app.v("bs_no_recoil")==true
    local percent=tonumber(app.v("bs_recoil_reduction")) or 100
    if not pd_weapon_number(percent) then percent=100 end
    percent=math.max(0,math.min(100,percent))
    local signature=tostring(enabled)..":"..tostring(percent)
    local changed=signature~=pd_recoil_signature
    s.frame_visits=0; s.reduction=percent; s.enabled=enabled
    local reserved=math.max(0,math.min(64,tonumber(app.pd_observer_reserved) or 0))
    local frame_budget=PD_RECOIL_FRAME_VISITS-reserved
    if not enabled then
        if not force and not changed and now-s.last_scan<PD_RECOIL_RESTORE_INTERVAL then return s end
        s.last_scan=now
        if next(pd_recoil_originals) then app.pd_weapon_cleanup() end
        pd_recoil_signature=signature; pd_recoil_cursor=nil
        s.status=s.pending>0 and "Restore pending" or "Off"
        s.weapons=0; s.patterns=0; s.numeric=0; s.verified=0; s.visited=0; s.limit_hit=false
        s.held_numeric=0;s.held_verified=0;s.held_path=nil;s.held_roots={}
        s.scanning=false; s.complete=false
        return s
    end
    local storage=pd_weapon_read(game,"ReplicatedStorage")
    local ranged=pd_weapon_find(storage,"RangedWeapons")
    local equipped,equipped_id=pd_equipped_sampled(now,force or changed)
    local probe=pd_equipped_sample.probe
    if probe and not probe.done then
        local visits=pd_probe_step(probe,frame_budget)
        s.frame_visits=s.frame_visits+visits
        if not probe.done then
            s.scanning=true;s.complete=false;s.status="Resolving held recoil definition"
            s.held_numeric=0;s.held_verified=0;s.held_path="ViewModel/Item/SelfRef / validating numeric pattern children"
            return s
        end
    end
    local held_definition,held_source,held_name,held_id=pd_definition_selected()
    if not ranged and not held_definition then
        if next(pd_recoil_originals) then app.pd_weapon_cleanup("Waiting for RangedWeapons") end
        s.enabled=true; s.status=s.pending>0 and "Restore pending" or "Waiting for RangedWeapons"
        pd_recoil_signature=signature; pd_recoil_cursor=nil; s.scanning=false; s.complete=false
        return s
    end
    local cursor=pd_recoil_cursor
    -- Tool/slider changes start a new generation with the held gun first. Old
    -- captures remain owned until a complete generation proves they disappeared.
    local root_id=ranged and pd_weapon_identity(ranged) or "ViewModel/Item/SelfRef"
    local restart=force or changed or pd_recoil_root_id~=root_id or pd_recoil_equipped_id~=equipped_id
        or pd_recoil_definition_id~=held_id
    if not cursor and not restart and now-pd_recoil_completed_at<PD_RECOIL_SCAN_INTERVAL then return s end
    if not cursor or restart then
        local weapons=pd_weapon_children(ranged)
        if held_definition then
            local ordered={held_definition};local seen={[held_id]=true}
            -- SelfRef may point to a live clone rather than the replicated
            -- definition. Keep that actual object first and visit each once.
            for _,weapon in ipairs(weapons) do
                local id=pd_weapon_identity(weapon)
                if not seen[id] then seen[id]=true;ordered[#ordered+1]=weapon end
            end
            weapons=ordered
        end
        s.generation=s.generation+1
        cursor={root_id=root_id,weapons=weapons,wi=1,stage="weapon",
            seen={},equipped_id=equipped_id,generation=s.generation,held_id=held_id}
        pd_recoil_cursor=cursor; pd_recoil_signature=signature
        pd_recoil_root_id=root_id; pd_recoil_equipped_id=equipped_id
        pd_recoil_definition_id=held_id
        s.last_scan=now; s.weapons=0; s.patterns=0; s.numeric=0; s.verified=0
        s.failed=0; s.pending=0; s.error=nil; s.visited=s.frame_visits; s.limit_hit=false
        s.scanning=true; s.complete=false; s.equipped=equipped
        s.held_observed=nil
        s.held_numeric=0;s.held_verified=0;s.held_roots={}
        if held_definition then
            for _,root in ipairs(pd_weapon_roots(held_definition)) do s.held_roots[#s.held_roots+1]=pd_weapon_read(root,"Name") end
            s.held_path=held_source.." -> "..tostring(held_name).."/"..table.concat(s.held_roots," + ")
        else s.held_path="No exact held recoil definition found" end
    end
    local done=false
    while s.frame_visits<frame_budget do
        local object
        if cursor.stage=="weapon" then
            object=cursor.weapons[cursor.wi]
            if not object then done=true; break end
            cursor.wi=cursor.wi+1
            local roots=pd_weapon_valid(object) and pd_weapon_roots(object) or {}
            if #roots>0 then
                s.weapons=s.weapons+1
                cursor.weapon_name=pd_weapon_read(object,"Name")
                cursor.weapon_id=pd_weapon_identity(object)
                cursor.roots=roots;cursor.root_index=1;cursor.stage="root"
            end
        elseif cursor.stage=="root" then
            local root=cursor.roots[cursor.root_index]
            if not root then cursor.stage="weapon"
            else
                cursor.root_index=cursor.root_index+1;cursor.root_name=pd_weapon_read(root,"Name")
                cursor.patterns=pd_weapon_children(root);cursor.pi=1;cursor.stage="pattern"
            end
        elseif cursor.stage=="pattern" then
            object=cursor.patterns[cursor.pi]
            if not object then cursor.stage="root"
            else
                cursor.pi=cursor.pi+1
                if pd_weapon_valid(object) then
                    s.patterns=s.patterns+1
                    cursor.pattern_name=pd_weapon_read(object,"Name")
                    cursor.values=pd_weapon_children(object); cursor.vi=1; cursor.stage="value"
                end
            end
        else
            object=cursor.values[cursor.vi]
            if not object then cursor.stage="pattern"
            else
                cursor.vi=cursor.vi+1
                if pd_weapon_valid(object) and pd_weapon_number(pd_weapon_read(object,"Value")) then
                    local id=pd_weapon_identity(object)
                    if not cursor.seen[id] then
