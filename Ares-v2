-- Shared, profile-backed health palette and a PNG-based character compositor.
do
    local ramp,signature={},{}
    local stats={palette_builds=0,health_bands=0,character_draws=0}
    local fields={"_hp_low","_hp_mid","_hp_high"}
    local function palette()
        local changed=#ramp==0;local index=0
        for _,field in ipairs(fields) do
            local color=ui.colors[field]
            for channel=1,4 do index=index+1;if signature[index]~=color[channel] then changed=true end end
        end
        if not changed then return end
        index=0
        for _,field in ipairs(fields) do for channel=1,4 do index=index+1;signature[index]=ui.colors[field][channel] end end
        local low,mid,high=ui.colors._hp_low,ui.colors._hp_mid,ui.colors._hp_high
        for i=0,256 do
            local left,right,t=low,mid,i/128
            if i>128 then left,right,t=mid,high,(i-128)/128 end
            local color={};for channel=1,4 do color[channel]=left[channel]+(right[channel]-left[channel])*t end
            ramp[i+1]=color
