    app.mobility.underground.head_only=head_only
    if missing>0 then return false,"Collision access missing on "..missing.." part(s)" end
    if failed>0 then return false,"Collision write failed on "..failed.." part(s)" end
    if count==0 then return false,"Waiting for character parts" end
    return true
end

