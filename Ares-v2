        local cycle=observation.cycle or observation.last_cycle_result
        if cycle then
            lines[#lines+1]="Fire input event: "..tostring(cycle.started).." | confirmed_shot=false"
            snapshot_lines(lines,"Before fire input maintenance",cycle.before)
            snapshot_lines(lines,"After 100 ms",cycle.after_100ms)
            snapshot_lines(lines,"After 300 ms",cycle.after_300ms)
        else lines[#lines+1]="Fire input event: not observed for this definition/configuration" end
        snapshot_lines(lines,"Latest held-input audit",observation.audit)
