-- Captured-value restoration. Disabled controls never write assumed defaults.
function app.restore(tag)
    local saved=app.originals[tag]
    if not saved then return end
    local ok,err=pcall(saved.write,saved.value)
    if ok then app.originals[tag]=nil
    else error("Restore "..tag..": "..tostring(err)) end
end
function app.override(tag,owner,read,write,value,enabled)
    local saved=app.originals[tag]
    if saved and saved.owner~=owner then app.restore(tag); saved=nil end
    if not enabled then app.restore(tag); return end
    if not saved then
        local original=read()
        if original==nil then error("Original value missing: "..tag) end
        saved={owner=owner,value=original,write=write}; app.originals[tag]=saved
    end
    write(value)
end
function app.property(tag,obj,field,value,enabled,owner)
    if not obj then app.restore(tag); return end
    app.override(tag,owner or tostring(obj.Address or obj),function() return obj[field] end,function(v) obj[field]=v end,value,enabled)
end
