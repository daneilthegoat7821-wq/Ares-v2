        "aim_prediction","aim_lead","aim_ballistic","aim_bullet_speed","aim_drop","aim_gravity","aim_max_flight","aim_delivery"}
    local native_names={"IsReady","IsVisible","EnableSilentHook","IsSilentHookActive","SetSilentTarget",
