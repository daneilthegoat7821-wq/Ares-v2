    end
    local function ratio(hp,maxhp)
        if type(hp)~="number" or hp~=hp or math.abs(hp)==math.huge then hp=0 end
        if type(maxhp)~="number" or maxhp~=maxhp or math.abs(maxhp)==math.huge or maxhp<=0 then maxhp=1 end
        return clamp(hp/maxhp,0,1)
    end
    function app.health_color(hp,maxhp,alpha)
        palette();local color=ramp[math.floor(ratio(hp,maxhp)*256+.5)+1]
        return raw(color,alpha or 1)
