end


-- Cache instance resolution, never character positions or health. Positive part
-- handles expire after 200 ms of synced frame time; missing names are retried
-- on the next sync. Reading a bone never samples the clock or retains Position.
do
    local PART_TTL=0.20
    local frame=0
    local sync_time=nil
    local rows,row_count={},0
    local points,bounds={},{}
    local last_prune=-100
    local stats={part_hits=0,part_lookups=0,part_invalidations=0,point_hits=0,
        point_queries=0,visibility_skips=0,bounds_hits=0,bounds_queries=0,frames=0,retained_characters=0}

    local function address(object)
        if not object then return nil end
        return object.Address or object
    end
    local function same_object(left,right)
        return left==right or (left and right and address(left)==address(right))
    end
    local function character_key(record)
        return record.char and tostring(address(record.char)) or nil
    end
    local function valid_part(part,character)
        if not part then return false end
        local ok,valid=pcall(function()
            return utility.IsValid(part) and same_object(part.Parent,character)
        end)
        return ok and valid==true
    end
    local function read_position(part)
        local ok,position=pcall(function() return part.Position end)
        if ok then return position end
    end
    local function find(character,name)
        stats.part_lookups=stats.part_lookups+1
        local ok,part=pcall(function() return character:FindFirstChild(name) end)
        if ok then return part end
    end
    local function clear()
        rows={}; row_count=0; points={};bounds={};stats.retained_characters=0
    end
    app.runtime_cache_clear=clear
    function app.runtime_cache_snapshot()
        local result={}
        for key,value in pairs(stats) do result[key]=value end
        return result
    end
    local original_sync=app.sync
    function app.sync()
        frame=frame+1; stats.frames=stats.frames+1; points={};bounds={}
        local now=utility.GetTime()
        sync_time=now
        if now-last_prune>=2 then
            last_prune=now
            for key,row in pairs(rows) do
                if now-row.seen>=2 then rows[key]=nil;row_count=row_count-1 end
            end
            stats.retained_characters=row_count
        end
        return original_sync()
    end
    function app.bone(record,name)
        local character=record and record.char
        if not character then return nil end
        local now=sync_time or utility.GetTime()
        local key=character_key(record)
        local row=rows[key]
        if not row or not same_object(row.character,character) then
            -- Bound retained handles even in a long session with many respawns.
            if row_count>=512 then clear() end
            row={character=character,parts={},seen=now}; rows[key]=row;row_count=row_count+1
            stats.retained_characters=row_count
        end
        row.seen=now
