    local function aim()
        frame()
        local me=app.me; local owner=me and me.Character and tostring(me.Character.Address or me.Character)
        if owner~=A.owner then
            A.owner=owner; A.cache={}; A.scan_cursor=nil; A.pending={}; A.overlay_allowed={}
