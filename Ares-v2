    for _,part in ipairs(state.parts_cache) do
        local ok,ispart=pcall(function() return part:IsA("BasePart") end)
        if ok and ispart and utility.IsValid(part) then
            local original=mobility_read(part,"CanCollide")
            if type(original)~="boolean" then missing=missing+1
            else
                local tag="mobility:collision:"..state.owner..":"..tostring(part.Address or part)
                if not state.tag_set[tag] then state.tags[#state.tags+1]=tag; state.tag_set[tag]=true end
                local desired=head_only and mobility_read(part,"Name")=="Head" or false
                local wrote=pcall(function()
                    if not app.originals[tag] then app.originals[tag]={owner=state.owner,value=original,write=function(value)
                        -- A removed/destroyed instance must not block restoration of the rest.
                        if utility.IsValid(part) then part.CanCollide=value end
                    end} end
                    if original~=desired then part.CanCollide=desired; state.collision_writes=(state.collision_writes or 0)+1 end
                end)
