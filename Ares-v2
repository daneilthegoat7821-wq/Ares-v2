    local function stroke(x1,y1,x2,y2,fraction,alpha,width)
        fraction=clamp(fraction)
        if fraction>0 then draw.Line(x1,y1,x1+(x2-x1)*fraction,y1+(y2-y1)*fraction,color(.89,alpha),width) end
    end
    function app.render_loading_collab(elapsed,sw,sh,reduce_motion)
        if not finite(sw) or not finite(sh) or sw<64 or sh<64 then return {valid=false,duration=duration} end
        elapsed=finite(elapsed) and math.max(0,elapsed) or 0
        local reduced=reduce_motion==true
        local fade=math.min(smooth(elapsed/.34),smooth((duration-elapsed)/.55))
        local ares_in=smooth((elapsed-.1)/.6)
        local vector_in=smooth((elapsed-.98)/.66)
        local cross_one=smooth((elapsed-.66)/.29)
        local cross_two=smooth((elapsed-.88)/.29)
        local footer_in=smooth((elapsed-1.58)/.48)
        if reduced then ares_in=1;vector_in=1;cross_one=1;cross_two=1;footer_in=1 end
        local scale=math.min(1,(sw-32)/572,(sh-32)/292)
        local w,h=572*scale,292*scale
        local x,y=(sw-w)*.5,(sh-h)*.5
        if not reduced then y=y+(1-smooth(elapsed/.64))*7*scale end
        local left,right,middle=x+156*scale,x+416*scale,x+w*.5
        local mark_y=y+63*scale
        local ares_shift=not reduced and (1-ares_in)*10*scale or 0
        local vector_shift=not reduced and (1-vector_in)*14*scale or 0
        local aa,va=fade*ares_in,fade*vector_in
        draw.RectFilled(0,0,sw,sh,color(0,.4*fade),0)
        -- Fixed contour glow: six bands, independent of resolution and time.
        for i=6,1,-1 do
            local spread=i*2*scale
            draw.Rect(x-spread,y-spread,w+spread*2,h+spread*2,color(.9,fade*.017*(7-i)/6),11*scale+spread,2*scale)
        end
        draw.RectFilled(x,y,w,h,color(.022,.985*fade),11*scale)
        draw.Rect(x,y,w,h,color(.36,.54*fade),11*scale,1)
        draw.Line(x+18*scale,y+.5*scale,x+w-18*scale,y+.5*scale,color(.84,.28*fade),1)
        draw.Text(x+23*scale,y+20*scale,"A R E S  V2",color(.78,.72*fade),10*scale)
        local meta="STARTUP SEQUENCE"
        local meta_width=tsize(meta,9*scale)
        draw.Text(x+w-23*scale-meta_width,y+21*scale,meta,color(.48,.8*fade),9*scale)
        draw.Line(x+23*scale,y+43*scale,x+w-23*scale,y+43*scale,color(.2,.72*fade),1)
        -- A compact nested halo stays behind the Vector silhouette. No particles.
        local halo=va*(reduced and 1 or (.9+.1*math.sin(math.max(0,elapsed-1.55)*2)))
        if type(app.preview_loading_aura)=="function" then
            image(app.preview_loading_aura,right-98*scale+vector_shift,mark_y-19*scale,196*scale,150*scale,halo*.7)
        else
            for i=5,1,-1 do
                local radius=(25+i*7)*scale
                draw.CircleFilled(right+vector_shift,mark_y+54*scale,radius,cyan(halo*(.007+(6-i)*.0015)),48)
            end
        end
        image(app.preview_loading_ares,left-71*scale-ares_shift,mark_y,142*scale,112*scale,aa)
        image(app.preview_loading_vector,right-71*scale+vector_shift,mark_y,142*scale,112*scale,va)
        local cy=mark_y+55*scale
        local arm=10*scale
        stroke(middle-arm,cy-arm,middle+arm,cy+arm,cross_one,fade*.8,1.5*scale)
        stroke(middle+arm,cy-arm,middle-arm,cy+arm,cross_two,fade*.8,1.5*scale)
        center(left-ares_shift,y+188*scale,"A R E S",aa,16*scale,.94)
        center(right+vector_shift,y+188*scale,"V E C T O R",va,14*scale,.91)
        -- A short travelling highlight passes once while the finished lockup holds.
        if not reduced and elapsed>=1.65 and elapsed<=2.9 then
            local travel=clamp((elapsed-1.65)/1.25)
            local sweep_x=x+24*scale+(w-48*scale)*travel
            for i=1,8 do
                local tail=(8-i)*6*scale
                local sx=math.max(x+24*scale,sweep_x-tail)
                local ex=math.min(x+w-24*scale,sx+6*scale)
                if ex>sx then draw.Line(sx,y+43*scale,ex,y+43*scale,color(1,fade*.023*i),1) end
            end
        end
        local track_x,track_y,track_w=x+24*scale,y+235*scale,w-48*scale
        local progress=smooth(elapsed/duration)
        draw.RectFilled(track_x,track_y,track_w,1.5*scale,color(.16,.85*fade),1)
        draw.RectFilled(track_x,track_y,track_w*progress,1.5*scale,color(.86,.88*fade),1)
        local caption_alpha=fade*footer_in
        local footer_size=12*scale
        local lead_width=tsize("Powered by ",footer_size)
        local brand_width=tsize("VECTOR",footer_size)
        local footer_x=middle-(lead_width+brand_width)*.5
        draw.Text(footer_x,y+253*scale,"Powered by ",color(.8,caption_alpha*.86),footer_size)
        draw.Text(footer_x+lead_width,y+253*scale,"VECTOR",cyan(caption_alpha*.94),footer_size)
        -- Export stable geometry for fixture verification without maintaining state.
        return {valid=true,duration=duration,elapsed=elapsed,alpha=fade,x=x,y=y,w=w,h=h,scale=scale,
            ares_x=left-71*scale-ares_shift,vector_x=right-71*scale+vector_shift,mark_y=mark_y,
            mark_w=142*scale,mark_h=112*scale,ares_alpha=aa,vector_alpha=va,footer_alpha=caption_alpha,
            progress=progress,cross_one=cross_one,cross_two=cross_two}
    end
end


-- ARES x VECTOR startup: three private lazy image slots, 3.6 seconds total.
-- The approved pure renderer owns the presentation; this module owns its lifetime.
do
    local duration=3.6
    local state={elapsed=0,duration=duration,done=false,attempts=0,draws=0,failures=0,
        resources=0,ready=false,submitted=false,ready_count=0,submitted_count=0,
        phase="waiting",clock_resets=0,retained=false}
    local entries,roles={},{}
    local last_time,frame,last_start,rotation=nil,0,-1,0
    local function finite(v) return type(v)=="number" and v==v and math.abs(v)<math.huge end
    local function unit(v) return math.max(0,math.min(1,v)) end
    for _,spec in ipairs(app.loading_asset_specs or {}) do
        if #entries<3 and (spec.role=="ares" or spec.role=="vector" or spec.role=="aura") and not roles[spec.role] then
            local entry={spec=spec,role=spec.role,key=spec.key,attempts=0,draws=0,failures=0,
                resources=0,ready=false,submitted=false,phase="waiting",next_poll=0,started_at=0}
            entries[#entries+1]=entry;roles[spec.role]=entry
        end
    end
    local function totals()
        local resources,ready,submitted,retained=0,0,0,false
        for _,entry in ipairs(entries) do
            resources=resources+entry.resources
            if entry.handle and entry.ready then ready=ready+1 end
            if entry.handle and entry.submitted then submitted=submitted+1 end
            retained=retained or entry.retained==true
        end
        state.resources=resources;state.ready_count=ready;state.submitted_count=submitted
        state.ready=ready==#entries and #entries>0;state.submitted=submitted>0;state.retained=retained
    end
    local function release(entry)
        if not entry.handle then return true end
        -- One failed release quarantines that slot; never poll or retry it again.
        if entry.retained then return false end
        if not draw or type(draw.FreeImage)~="function" then entry.retained=true;totals();return false end
        local ok,result=pcall(draw.FreeImage,entry.handle)
        if not ok or result==false then entry.retained=true;totals();return false end
        entry.handle=nil;entry.resources=0;entry.ready=false;entry.submitted=false;entry.retained=false
        totals();return true
    end
    local function clear_input()
        if ui and ui.mouse then
            local left,right=false,false
            if input and type(input.IsKeyDown)=="function" then
                local ok,value=pcall(input.IsKeyDown,1);left=ok and value==true
                ok,value=pcall(input.IsKeyDown,2);right=ok and value==true
            end
            ui.mouse.clicked=false;ui.mouse.rclicked=false;ui.mouse.was=left;ui.mouse.rwas=right
        end
        if app.cursor then app.cursor.armed=false end
    end
    local function finish(reason)
        if state.done then return end
        clear_input();state.done=true;state.phase=reason or "complete"
        for _,entry in ipairs(entries) do release(entry);entry.phase=entry.retained and "retained" or "finished" end
        totals()
    end
    function app.loading_skip() finish("skipped");return true end
    function app.loading_status()
        totals()
        local out={images={}}
        for k,v in pairs(state) do if type(v)~="table" and type(v)~="function" then out[k]=v end end
        for _,entry in ipairs(entries) do
            local row={}
            for k,v in pairs(entry) do
                if k~="handle" and type(v)~="table" and type(v)~="function" then row[k]=v end
            end
            out.images[#out.images+1]=row
        end
        return out
    end
    local function fail(entry,reason)
        if entry.retained or entry.failed then return end
        entry.failed=true;entry.failures=entry.failures+1;state.failures=state.failures+1
        entry.last_error=reason;state.last_error=reason;entry.phase="retry"
        if release(entry) then entry.next_poll=state.elapsed+.08 else entry.phase="retained" end
    end
    local function poll(entry)
        if entry.ready or not entry.handle or entry.retained or entry.failed or state.elapsed<entry.next_poll then return end
        entry.next_poll=state.elapsed+.125
        if type(draw.ImageFailed)=="function" then
            local ok,value=pcall(draw.ImageFailed,entry.handle)
            if ok and value==true then fail(entry,"PNG download/decode failed");return end
        end
        if not entry.ready and type(draw.ImageLoaded)=="function" then
            local ok,value=pcall(draw.ImageLoaded,entry.handle)
            if ok and value==true then entry.ready=true;entry.readiness="ImageLoaded" end
        end
        if not entry.ready and type(draw.ImageSize)=="function" then
            local ok,w,h=pcall(draw.ImageSize,entry.handle)
            if ok and finite(w) and finite(h) and w>0 and h>0 and w<65536 and h<65536 then
                entry.ready=true;entry.readiness="ImageSize"
            end
        end
        if entry.ready then entry.phase="ready"
        elseif entry.submitted then entry.phase="draw accepted" end
        -- The Vector lockup is intentionally hidden until 0.98s. Give a native
        -- draw-only compatibility path its first visible submission before aging it out.
        local reveal_at=entry.role=="ares" and .1 or .98
        if not entry.ready and not entry.submitted and state.elapsed-math.max(entry.started_at,reveal_at)>=5 then
            fail(entry,"PNG readiness timeout")
        end
    end
    local function image_service()
        if not draw or type(draw.LoadImage)~="function" or type(draw.Image)~="function" then return end
        for _,entry in ipairs(entries) do poll(entry) end
        if last_start==frame or #entries==0 then totals();return end
        for offset=1,#entries do
            local index=(rotation+offset-1)%#entries+1
            local entry=entries[index]
            if not entry.handle and not entry.retained and entry.attempts<3 and state.elapsed>=entry.next_poll then
                rotation=index;last_start=frame
                entry.attempts=entry.attempts+1;state.attempts=state.attempts+1
                entry.failed=false;entry.ready=false;entry.submitted=false;entry.readiness=nil;entry.last_error=nil
                local revision=tostring(entry.spec.hash or "1")..".collab."..entry.attempts
                local url
                entry.source="GitHub"
                if type(entry.spec.url)=="string" and entry.spec.url~="" then
                    url=entry.spec.url..(entry.spec.url:find("?",1,true) and "&" or "?").."rev="..revision
                end
                if not url then
                    fail(entry,"PNG source unavailable")
                else
                    local ok,value=pcall(draw.LoadImage,url)
                    if ok and value and value~=0 then
                        entry.handle=value;entry.resources=1;entry.next_poll=state.elapsed
                    else fail(entry,"PNG loader returned no handle") end
                end
                break
            end
        end
        totals()
    end
    local function image(entry,x,y,w,h,alpha)
        if state.done or not entry or not entry.ready or not entry.handle or entry.retained or entry.failed or type(draw.Image)~="function" then return false end
        local spec=entry.spec
        if not finite(alpha) or alpha<=0 or not finite(w) or not finite(h) or w<=0 or h<=0 then return false end
        local tint=spec.tint or {255,255,255}
        if entry.role~="aura" then
            local iw,ih,left,top,cw,ch=spec.w,spec.h,spec.left or 0,spec.top or 0,spec.cw or spec.w,spec.ch or spec.h
            if not finite(iw) or not finite(ih) or not finite(cw) or not finite(ch) or cw<=0 or ch<=0 then return false end
            local scale=math.min(w/cw,h/ch)
            x=x+(w-cw*scale)*.5-left*scale;y=y+(h-ch*scale)*.5-top*scale
            w=iw*scale;h=ih*scale
        end
        local ok,result=pcall(draw.Image,entry.handle,x,y,w,h,tint[1],tint[2],tint[3],math.floor(unit(alpha)*255+.5))
        if ok and result~=false then
            entry.submitted=true;entry.draws=entry.draws+1;state.draws=state.draws+1
            if not entry.ready then entry.readiness="draw accepted (unverified)";entry.phase="draw accepted" end
            return true
        end
        if entry.ready then fail(entry,"PNG draw rejected") end
        return false
    end
    app.preview_loading_ares=function(x,y,w,h,alpha) image(roles.ares,x,y,w,h,alpha) end
    app.preview_loading_vector=function(x,y,w,h,alpha) image(roles.vector,x,y,w,h,alpha) end
    app.preview_loading_aura=function(x,y,w,h,alpha) image(roles.aura,x,y,w,h,alpha) end
    local function render()
        local sw,sh=draw.GetScreenSize()
        if not finite(sw) or not finite(sh) or sw<64 or sh<64 then return end
        if type(app.render_loading_collab)~="function" then error("Loading renderer missing") end
        local layout=app.render_loading_collab(state.elapsed,sw,sh,app.v and app.v("ui_reduce_motion")==true)
        if type(layout)=="table" then state.alpha=layout.alpha;state.progress=layout.progress end
        totals()
    end
    function app.loading_frame(now)
        if app.stopped then finish("stopped");return false end
        if state.done then return false end
        if not finite(now) then now=last_time or 0 end
        if last_time then
            local step=now-last_time
            if step<=0 then
                if step<0 then state.clock_resets=state.clock_resets+1 end
                local ok,value=false,nil
                if utility and type(utility.GetDeltaTime)=="function" then ok,value=pcall(utility.GetDeltaTime) end
                step=ok and finite(value) and math.max(.0001,math.min(.1,value)) or 1/60
            end
            state.elapsed=math.min(duration,state.elapsed+step)
        end
        last_time=now;frame=frame+1
        if state.elapsed>=duration then finish("complete");return false end
        state.phase=state.elapsed<.34 and "fade in" or state.elapsed>duration-.55 and "fade out" or state.elapsed<1.65 and "reveal" or "hold"
        image_service()
        local ok=pcall(render)
        if not ok then state.last_error="Startup drawing failed";finish("visual fallback");return false end
        return true
    end
    local previous_action=app.action
    function app.action(id)
        if id=="shutdown" then finish("stopped") end
        return previous_action(id)
    end
end


-- Read-only velocity monitor. Native reads run at 10 Hz; storage and drawing are bounded.
do
    local CAP, HZ, MAX_POINTS = 120, 10, 65
    local S={head=0,count=0,next_sample=nil,last_clock=nil,last_sample=nil,character=nil,
        enabled=false,signal=false,reads=0,accepted=0,gaps=0,resets=0,distance=0,
        peak={0,0,0},smooth={0,0,0},accel={0,0,0},raw={0,0,0},vertical=0,
        text_due=0,text_units=0,text_mode=0,value_text="No signal",unit_text="",details_text="",
        draw_points=0,scale=20,draw_clock=nil}
    local history,points,quads={},{},{}
    for i=1,CAP do history[i]={t=0,valid=false,0,0,0} end
    for i=1,MAX_POINTS do points[i]={0,0,connect=false} end
    for i=1,MAX_POINTS-1 do quads[i]={{0,0},{0,0},{0,0},{0,0}} end
    local C={card={0,0,0,0},edge={0,0,0,0},shadow={0,0,0,0},line={0,0,0,0},
        fill={0,0,0,0},grid={0,0,0,0},text={0,0,0,0},sub={0,0,0,0},
        halo={0,0,0,0},halo2={0,0,0,0}}
    local default_accent={0.24,0.76,0.88,1}
    local function finite(n) return type(n)=="number" and n==n and n>-math.huge and n<math.huge end
    local function option(id,default,lo,hi)
        local n=app.n(id)
        if not finite(n) or not app.schema[id] then n=default end
        return clamp(n,lo,hi)
    end
    local function mode() return math.floor(option("velocity_mode",1,1,3)+0.5) end
    local function units() return math.floor(option("velocity_units",1,1,3)+0.5) end
    local function empty_history()
        S.head=0; S.count=0; S.last_sample=nil; S.character=nil; S.signal=false
        S.draw_points=0; S.scale=20; S.text_due=0
        for i=1,3 do S.smooth[i]=0; S.accel[i]=0 end
    end
    local function append(now,valid)
        S.head=S.head%CAP+1; S.count=math.min(CAP,S.count+1)
        local cell=history[S.head]; cell.t=now; cell.valid=valid
        if valid then for i=1,3 do cell[i]=S.smooth[i] end end
    end
    local function missing(now)
        if S.signal then S.gaps=S.gaps+1 end
        S.signal=false; S.last_sample=nil; S.character=nil; S.text_due=0
        for i=1,3 do S.accel[i]=0 end
        append(now,false)
    end
    local function read_velocity()
        local lp=entity.GetLocalPlayer()
        if not lp then return nil end
        local velocity=lp.Velocity
        if not velocity then return nil end
        local x,y,z=velocity.X,velocity.Y,velocity.Z
        if not finite(x) or not finite(y) or not finite(z) then return nil end
        -- Reject impossible magnitudes before squaring, so an invalid native read never overflows.
        if math.abs(x)>50000 or math.abs(y)>50000 or math.abs(z)>50000 then return nil end
        return x,y,z,lp
    end
    local function character_id(lp)
        local char=lp.Character
        if not char then return nil end
        -- Instance addresses remain stable even when the VM returns a fresh wrapper.
        return char.Address or char
    end
    local function update_text(now)
        local m,u=mode(),units()
        if now<S.text_due and m==S.text_mode and u==S.text_units then return end
        S.text_due=now+0.1; S.text_mode=m; S.text_units=u
        local factor=u==2 and 0.28 or (u==3 and 1.008 or 1)
        S.unit_text=u==2 and "m/s" or (u==3 and "km/h" or "studs/s")
        if not S.signal then
            S.value_text="No signal"; S.details_text="Waiting for local character"
            return
        end
        S.value_text=string.format("%.1f",S.smooth[m]*factor)
        S.details_text=string.format("Y %+.1f   /   ACC %+.1f   /   PEAK %.1f",
            S.vertical*factor,S.accel[m]*factor,S.peak[m]*factor)
    end
    function app.velocity_reset()
        empty_history(); S.next_sample=nil; S.last_clock=nil; S.draw_clock=nil
        S.distance=0; S.resets=S.resets+1
        for i=1,3 do S.peak[i]=0; S.raw[i]=0 end
        S.vertical=0; S.value_text="No signal"; S.details_text="Waiting for local character"
    end
    function app.velocity_service(now)
        if not app.v("hud_velocity") then
            if S.enabled then empty_history(); S.next_sample=nil end
            S.enabled=false
            return
        end
        S.enabled=true
        if not finite(now) then return end
        if S.last_clock and now<S.last_clock then
            empty_history(); S.next_sample=nil; S.resets=S.resets+1
        end
        S.last_clock=now
        if S.next_sample and now+0.000001<S.next_sample then return end
        -- One sample per call: a stalled frame never causes a catch-up burst.
        S.next_sample=now+1/HZ
        local previous_time=S.last_sample
        if previous_time and now-previous_time>0.75 then
            empty_history(); S.resets=S.resets+1; previous_time=nil
        end
        S.reads=S.reads+1
        local ok,x,y,z,lp=pcall(read_velocity)
        if not ok or x==nil then missing(now); update_text(now); return end
        local identified,id=pcall(character_id,lp)
        if not identified then id=nil end
        if id and S.character and id~=S.character then
            empty_history(); S.resets=S.resets+1; previous_time=nil
        end
        local planar=math.sqrt(x*x+z*z)
        local total=math.sqrt(x*x+y*y+z*z)
        local vertical=math.abs(y)
        local dt=previous_time and now-previous_time or 0
        -- Abrupt velocity discontinuities start a fresh graph instead of drawing a tall diagonal.
        if dt>0 and math.abs(total-S.raw[2])>math.max(160,S.raw[2]*4) then
            empty_history(); S.resets=S.resets+1; dt=0
        end
        local smoothing=option("velocity_smooth",45,0,100)
        local blend=(dt<=0 or smoothing==0) and 1 or 1-math.exp(-dt*(24-smoothing*0.18))
        local old_planar=S.raw[1]
        local function put(i,value)
            S.accel[i]=dt>0 and (value-S.raw[i])/dt or 0
            S.raw[i]=value; S.smooth[i]=S.smooth[i]+(value-S.smooth[i])*blend
            S.peak[i]=math.max(S.peak[i],value)
        end
        put(1,planar); put(2,total); put(3,vertical)
        if dt>0 then S.distance=S.distance+(old_planar+planar)*0.5*dt end
        S.vertical=y; S.character=id; S.signal=true; S.last_sample=now
        S.accepted=S.accepted+1; append(now,true); update_text(now)
    end
    function app.velocity_status()
        local m=mode()
        return {enabled=S.enabled,signal=S.signal,speed=S.signal and S.raw[m] or nil,
            planar=S.signal and S.raw[1] or nil,total=S.signal and S.raw[2] or nil,
            vertical=S.signal and S.vertical or nil,acceleration=S.signal and S.accel[m] or nil,
            peak=S.peak[m],distance=S.distance,samples=S.count,capacity=CAP,sample_hz=HZ,
            reads=S.reads,accepted=S.accepted,gaps=S.gaps,resets=S.resets,mode=m,units=units(),
            width=option("velocity_width",320,240,440),height=app.v("velocity_details") and 136 or 104,
            max_points=MAX_POINTS,draw_points=S.draw_points,value_text=S.value_text,unit_text=S.unit_text}
    end
    local function color(dst,src,alpha)
        dst[1]=src[1]; dst[2]=src[2]; dst[3]=src[3]; dst[4]=(src[4] or 1)*alpha
    end
    function app.draw_velocity(now)
        if not app.v("hud_velocity") or not finite(now) then return end
        local widget=app.widgets.velocity
        if not widget then return end
        local sw,sh=draw.GetScreenSize()
        local w=option("velocity_width",320,240,440)
        w=math.min(w,math.max(160,sw-4))
        local details=app.v("velocity_details"); local h=details and 136 or 104
        widget.x=clamp(widget.x,2,math.max(2,sw-w-2)); widget.y=clamp(widget.y,2,math.max(2,sh-h-2))
        local x,y=widget.x,widget.y
        local alpha=option("hud_alpha",90,0,100)/100
