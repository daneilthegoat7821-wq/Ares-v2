            end
        end
        if count>0 and S.signal then
            local tip=points[count]
            if app.v("velocity_glow") then
                draw.CircleFilled(tip[1],tip[2],8,C.halo,20)
                draw.CircleFilled(tip[1],tip[2],5,C.halo2,16)
            end
            draw.CircleFilled(tip[1],tip[2],2.5,C.line,12)
        end
        if details then
            draw.Line(x+14,y+103,x+w-14,y+103,C.grid,1)
            tmid(x+14,y+106,22,S.details_text,C.sub,9)
        end
        if ui.open and not inside(ui.x,ui.y,ui.w,ui.h) and inside(x,y,w,32)
            and ui.mouse.clicked and not ui.drag and not ui.popup and not ui.picker and not ui.capture then
            ui.drag={kind="widget",key="velocity",ox=ui.mouse.x-x,oy=ui.mouse.y-y}
            ui.mouse.clicked=false
        end
    end
    local previous_action=app.action
    function app.action(id)
        if id=="velocity_reset" then app.velocity_reset(); return end
        return previous_action(id)
    end
end


-- Requests only bounded cached loopback responses while the menu is idle.
-- Public profile downloads run in the companion helper, never in a Lua frame.
do
    local entries,count={},0
    local next_poll,requests,last_error,last_clock=0,0,nil,nil
    local unknown={status="unavailable",error="No numeric account ID"}
    local function finite(n) return type(n)=="number" and n==n and math.abs(n)<math.huge end
    function app.account_lookup(uid)
        if not finite(uid) or uid<1 or uid>9007199254740991 or uid%1~=0 then return unknown end
        local key=string.format("%.0f",uid);local now=utility.GetTime()
        local row=entries[key]
        if not row then
            if count>=512 then
                local victim,oldest
                for id,value in pairs(entries) do
                    if not oldest or value.used<oldest then victim,oldest=id,value.used end
                end
                if victim then entries[victim]=nil;count=count-1 end
            end
            row={uid=key,status="pending",due=0,used=now};entries[key]=row;count=count+1
        end
        row.used=now
        return row
    end
    function app.account_service(now)
        if not app.v("cf_on") or not app.maintenance_allowed() or not finite(now) then return end
        if last_clock and now<last_clock then
            next_poll=0;for _,row in pairs(entries) do row.due=0 end
        end
        last_clock=now
        if now<next_poll then return end
        next_poll=now+2
        local selected,keys={},{}
        for key,row in pairs(entries) do
            if now-row.used<120 and now>=row.due then
                selected[#selected+1]=row
            end
        end
        table.sort(selected,function(a,b) return a.due<b.due or (a.due==b.due and a.uid<b.uid) end)
        local requested={}
        for i=1,math.min(16,#selected) do
            local row=selected[i];keys[#keys+1]=row.uid;requested[row.uid]=row;row.due=now+10
        end
        if #keys==0 then return end
        requests=requests+1
        local body,err=app.account_http(table.concat(keys,","))
        local prefix="ARES_ACCOUNTS1\n"
        if type(body)~="string" or #body>16000 or body:sub(1,#prefix)~=prefix then
            last_error=tostring(err or "Account helper unavailable"):sub(1,130);next_poll=now+30
            for _,row in pairs(requested) do row.status="unavailable";row.error=last_error;row.due=now+30 end
            return
        end
        last_error=nil
        for line in body:sub(#prefix+1):gmatch("[^\r\n]+") do
            local id,status,created,age,error_=line:match("^(%d+)|([a-z]+)|([^|]*)|([^|]*)|([^|]*)$")
            local row=id and requested[id]
            if row then
                local days=tonumber(age)
                if status=="ready" and created:match("^%d%d%d%d%-%d%d%-%d%d$") and finite(days)
                    and days>=0 and days<50000 and days%1==0 then
                    row.status="ready";row.created=created;row.age_days=days;row.error=nil;row.due=now+3600
                elseif status=="pending" then
                    row.status="pending";row.error=nil;row.due=now+4
                else row.status="unavailable";row.error=(error_~="" and error_ or "Profile unavailable"):sub(1,120);row.due=now+60 end
            end
        end
    end
    function app.account_status()
        local ready,pending=0,0
        for _,row in pairs(entries) do
            if row.status=="ready" then ready=ready+1 elseif row.status=="pending" then pending=pending+1 end
        end
        return {cached=count,ready=ready,pending=pending,requests=requests,error=last_error}
    end
    local previous=app.action
    function app.action(id)
        if id=="finder_refresh_accounts" then
            for _,row in pairs(entries) do row.due=0 end
            next_poll=0;last_error=nil;app.toast("Account profiles queued for refresh");return true
        end
        return previous(id)
    end
end


-- Visual feedback from local input and replicated HP. Vector exposes no shot or
-- damage event here: neither a tracer nor an HP correlation confirms a hit.
do
    local C={traces={},shots={},logs={},hp={},hp_count=0,marker=nil,next_fire=-100,
        next_cast=-100,next_hp=-100,cursor=1,generation=0,last=nil,enabled=false,
        pulses=0,correlations=0,reads=0,casts=0,resets=0}
    local function finite(n) return type(n)=="number" and n==n and math.abs(n)<1e8 end
    local function read(o,k)
        if not o then return nil end
        local ok,v=pcall(function() return o[k] end);if ok then return v end
    end
    local function xyz(v)
        local x,y,z=read(v,"X"),read(v,"Y"),read(v,"Z")
        if finite(x) and finite(y) and finite(z) then return x,y,z end
    end
    local function point(v)
        local x,y,z=xyz(v);if x then return {X=x,Y=y,Z=z} end
    end
    local function numeric(id,default,lo,hi)
        local v=app.n(id);return finite(v) and math.max(lo,math.min(hi,v)) or default
    end
    local function address(o) return o and (read(o,"Address") or o) end
    local function same(a,b) return a==b or (a and b and address(a)==address(b)) end
    local function key(p)
        local id=read(p,"UserId");if finite(id) and id>0 then return tostring(id) end
        local name=read(p,"Name");if type(name)=="string" and #name>0 then return name:sub(1,64) end
    end
    local function trimmed(t,now,life)
        for i=#t,1,-1 do if now-t[i].time>life or now<t[i].time then table.remove(t,i) end end
    end
    local function clear()
        C.traces={};C.shots={};C.logs={};C.hp={};C.hp_count=0;C.marker=nil
        C.next_fire=-100;C.next_cast=-100;C.next_hp=-100;C.cursor=1;C.generation=0
        C.last=nil;C.last_log=nil;C.enabled=false;C.hand=nil;C.hand_char=nil;C.hand_time=nil;C.resets=C.resets+1
    end
    app.combat_clear=clear
    local function projected(p)
        local x,y,z=xyz(p);if not x then return nil end
        local ok,sx,sy,on=pcall(draw.WorldToScreen,x,y,z)
        if ok and on==true and finite(sx) and finite(sy) then return sx,sy end
    end
    local function crosshair()
        -- Physical view centre remains the reference for local firing feedback.
        local sw,sh=draw.GetScreenSize();return sw*.5,sh*.5
    end
    local function fire_target()
        local t=app.target;local r=t and t.record
        local p=r and not r.npc and r.entity
        if p and read(p,"IsValid")~=false and read(p,"IsAlive")~=false then
            local char=read(p,"Character");local hum=read(p,"Humanoid")
            if char and hum and same(char,r.char) then return key(p),address(char),address(hum) end
        end
        local cx,cy=crosshair();local selected,best=nil,24*24
        for i,r1 in ipairs(app.records or {}) do
            if i>64 then break end
            if not r1.npc and r1.entity and finite(r1.hp) and r1.hp>0 then
                local sx,sy=projected(read(r1.entity,"HeadPosition") or r1.pos)
                if sx then
                    local d=(sx-cx)^2+(sy-cy)^2
                    if d<best then selected=r1.entity;best=d end
                end
            end
        end
        if selected then return key(selected),address(read(selected,"Character")),address(read(selected,"Humanoid")) end
    end
    local function tracer(now,lp)
        local origin=point(app.cam) or point(read(lp,"HeadPosition"))
        if not origin then local ok,p=pcall(camera.GetPosition);if ok then origin=point(p) end end
        local ok,look=pcall(camera.GetLookVector)
        local lx,ly,lz
        if ok then lx,ly,lz=xyz(look) end
        if not origin or not lx then return end
        local len=math.sqrt(lx*lx+ly*ly+lz*lz);if len<.0001 then return end
        local range=numeric("cb_trace_range",600,10,1500)/.28
        local endpoint={X=origin.X+lx/len*range,Y=origin.Y+ly/len*range,Z=origin.Z+lz/len*range}
        if app.ray_ready and raycast and type(raycast.Cast)=="function" and now>=C.next_cast then
            C.next_cast=now+.18;C.casts=C.casts+1
            local success,hit,p=pcall(raycast.Cast,Vector3.New(origin.X,origin.Y,origin.Z),Vector3.New(endpoint.X,endpoint.Y,endpoint.Z))
            local hitp=success and hit==true and point(p)
            if hitp then
                local dx,dy,dz=hitp.X-origin.X,hitp.Y-origin.Y,hitp.Z-origin.Z
                local along=(dx*lx+dy*ly+dz*lz)/len
                local off2=dx*dx+dy*dy+dz*dz-along*along
                if along>=0 and along<=range+.15 and off2<=1 then endpoint=hitp end
            end
        end
        local character=read(lp,"Character")
        if character and (not same(C.hand_char,character) or not C.hand_time or now-C.hand_time>=.25) then
            C.hand_char=character;C.hand=nil;C.hand_time=now
            for _,name in ipairs({"RightHand","Right Arm"}) do
                local good,part=pcall(function() return character:FindFirstChild(name) end)
                if good and part then C.hand=part;break end
            end
        end
        local visible_origin=C.hand and same(read(C.hand,"Parent"),character) and point(read(C.hand,"Position"))
        visible_origin=visible_origin or point(read(lp,"HeadPosition")) or origin
        C.traces[#C.traces+1]={time=now,from=visible_origin,to=endpoint,life=numeric("cb_trace_life",500,150,1500)/1000}
        while #C.traces>24 do table.remove(C.traces,1) end
    end
    local function pulse(now)
        if ui.open or ui.capture or ui.drag or (app.cursor_ready and not app.cursor_ready()) or now<C.next_fire then return end
        local ok,down=pcall(input.IsKeyDown,0x01);if not ok or not down then return end
        local lp=app.me
        if not lp or read(lp,"IsAlive")==false or read(lp,"IsValid")==false then return end
        local tool=read(lp,"ToolName")
        if type(tool)~="string" or #tool==0 or tool=="None" or tool=="none" then return end
        C.next_fire=now+.12;C.pulses=C.pulses+1
        local id,char,hum=fire_target()
        if id and char and hum then
            C.shots[#C.shots+1]={time=now,id=id,char=char,hum=hum}
            while #C.shots>8 do table.remove(C.shots,1) end
        end
        if app.v("cb_tracers") then tracer(now,lp) end
    end
    local function correlate(id,char,hum,now,previous_time)
        for i=#C.shots,1,-1 do
            local shot=C.shots[i]
            if shot.id==id and shot.char==char and shot.hum==hum and now-shot.time<=.75
                and now>=shot.time and previous_time<=shot.time+.12 then return true end
        end
        return false
    end
    local function sample(p,now)
        C.reads=C.reads+1
        if not p or read(p,"IsLocal") or read(p,"IsValid")==false then return end
        local id=key(p);local char=address(read(p,"Character"));local hum=address(read(p,"Humanoid"))
        local hp=read(p,"Health");if hp==nil then hp=read(read(p,"Humanoid"),"Health") end
        if not id or not char or not hum or not finite(hp) or hp<0 then return end
        local old=C.hp[id]
        if old and old.char==char and old.hum==hum and old.hp>0 and hp<old.hp
            and now-old.time<=1.25 and correlate(id,char,hum,now,old.time) then
            local amount=old.hp-hp
            C.correlations=C.correlations+1
            local log={time=now,name=tostring(read(p,"Name") or "Player"):sub(1,64),amount=amount,
                hp=hp,kill=hp==0,evidence="HP observed",correlation="Local input correlated"}
            C.last_log=log
            if app.v("cb_hitlogs") then
                C.logs[#C.logs+1]=log;while #C.logs>10 do table.remove(C.logs,1) end
            end
            if app.v("cb_hitmarkers") then
                C.marker={time=now,life=numeric("cb_marker_life",300,100,1000)/1000,kill=hp==0}
            end
        end
        if not old and C.hp_count>=256 then
            local oldest,age=nil,math.huge
            for saved,row in pairs(C.hp) do if row.time<age then oldest=saved;age=row.time end end
            if oldest then C.hp[oldest]=nil;C.hp_count=C.hp_count-1 end
        end
        local saved=C.hp[id]
        if not saved then saved={};C.hp[id]=saved;C.hp_count=C.hp_count+1 end
        saved.hp=hp;saved.char=char;saved.hum=hum;saved.time=now;saved.generation=C.generation
    end
    function app.combat_service(now)
        if not finite(now) then return end
        local enabled=app.v("cb_tracers") or app.v("cb_hitmarkers") or app.v("cb_hitlogs")
        if not enabled or app.stopped then if C.enabled then clear() end;return end
        if C.last and now<C.last then clear() end
        C.enabled=true;C.last=now
        if not app.v("cb_tracers") and #C.traces>0 then C.traces={} end
        if not app.v("cb_hitmarkers") then C.marker=nil end
        if not app.v("cb_hitlogs") and #C.logs>0 then C.logs={} end
        trimmed(C.shots,now,.75);trimmed(C.logs,now,numeric("cb_log_life",6,2,15))
        for i=#C.traces,1,-1 do if now-C.traces[i].time>C.traces[i].life then table.remove(C.traces,i) end end
        if C.marker and now-C.marker.time>C.marker.life then C.marker=nil end
        pulse(now)
        if not (app.v("cb_hitmarkers") or app.v("cb_hitlogs")) then
            if C.hp_count>0 then C.hp={};C.hp_count=0 end
            return
        end
        if now<C.next_hp then return end
        local players=app.players or {}
        if C.cursor==1 then C.generation=C.generation+1 end
        local stop=math.min(#players,C.cursor+31)
        for i=C.cursor,stop do sample(players[i],now) end
        C.cursor=stop+1
        if C.cursor>#players then
            C.cursor=1;C.next_hp=now+.1
            for id,row in pairs(C.hp) do
