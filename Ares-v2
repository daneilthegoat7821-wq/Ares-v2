                        if held then s.held_numeric=s.held_numeric+1 end
                        local ok,err=pd_weapon_apply(object,percent,cursor.weapon_name,cursor.pattern_name,cursor.weapon_id,cursor.root_name)
                        if ok then
                            s.verified=s.verified+1
                            if held then s.held_verified=s.held_verified+1 end
