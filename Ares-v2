    function app.aim()
        local ok,err=pcall(aim)
        if not ok then stop("Aim adapter error: "..tostring(err):sub(1,110),"unavailable",true) end
    end
    function app.aim_trace_probe()
        local c=A.probe_candidate
        if not c or not raycast or type(raycast.Cast)~="function" then return {state="not_available"} end
        local ok,hit,point,distance,object,terrain=pcall(raycast.Cast,vector(c.origin),vector(c.pos))
        if not ok then return {state="error",error=tostring(hit):sub(1,140)} end
