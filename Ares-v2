        local oldest=(S.head-S.count)%CAP+1
        local available=0; local maximum=16; local m=mode()
        for i=0,S.count-1 do
            local cell=history[(oldest+i-1)%CAP+1]
            if now-cell.t<=window and now>=cell.t then
                available=available+1
                if cell.valid then maximum=math.max(maximum,cell[m]*1.18) end
            end
        end
        local elapsed=S.draw_clock and clamp(now-S.draw_clock,0,0.1) or 0
        S.draw_clock=now
        if maximum>S.scale then S.scale=maximum
        else S.scale=S.scale+(maximum-S.scale)*(1-math.exp(-elapsed*2.5)) end
        local stride=math.max(1,math.ceil((available-1)/(MAX_POINTS-1)))
        local seen,count,connected=0,0,false
        for i=0,S.count-1 do
            local cell=history[(oldest+i-1)%CAP+1]
            local age=now-cell.t
