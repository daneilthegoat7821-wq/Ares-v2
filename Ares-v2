        local entry={spec=spec,attempts=0,next_try=0};images[spec.key]=entry;order[#order+1]=entry
    end
    local stats={resources=0,attempts=0,draws=0,failures=0,timeouts=0,rendered=0,candidates=0,checks=0,errors=0}
    local epoch=tostring(math.floor(utility.GetTime()*1000000));local revision=0
    local last_frame,last_started,last_time=-1,-1,0
    local pool,candidates={},{}
    local function finite(value) return type(value)=="number" and value==value and math.abs(value)<math.huge end
    local function release(entry)
        if entry.handle then
