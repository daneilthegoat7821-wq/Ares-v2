    end
    local function clean(value,limit)
        return tostring(value==nil and "unavailable" or value):gsub("[%z\r\n]"," "):sub(1,limit or 180)
    end
    local function copy(value,depth)
        local kind=type(value)
        if kind=="boolean" or kind=="string" then return kind=="string" and value:sub(1,240) or value end
        if kind=="number" then return value==value and math.abs(value)<math.huge and value or nil end
        if kind~="table" or (depth or 0)>=3 then return nil end
        local result,count={},0
        for key,item in pairs(value) do
            if type(key)=="string" or type(key)=="number" then
                local entry=copy(item,(depth or 0)+1)
                if entry~=nil then
                    result[type(key)=="string" and key:sub(1,72) or key]=entry
