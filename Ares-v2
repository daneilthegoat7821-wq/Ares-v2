    local function evict(wanted)
        if state.count<40 then return true end
        local oldest,oldtime
        for key,entry in pairs(state.cache) do if not wanted[key] and (not oldtime or entry.used<oldtime) then oldest,oldtime=key,entry.used end end
        if not oldest then return false end
        release(state.cache[oldest]); state.cache[oldest]=nil; state.count=state.count-1; return true
    end
    function app.loadout_service()
        local enabled=app.v("hud_loadout") or app.v("hud_inventory")
        if not enabled then if state.enabled or state.count>0 then app.loadout_cleanup() end return end
        state.enabled=true
        local now=utility.GetTime(); local player=select_target()
        local identity=player and app.identity(player) or nil
        if identity~=state.target or now-state.last_scan>=0.25 then
            state.target=identity; state.last_scan=now; state.data=player and app.loadout_read_player(player) or nil
