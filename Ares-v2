-- Bounded, frame-scheduled teleport burst. No waits, threads or native toasts.
do
    local COUNT,DURATION,COOLDOWN=3000,2,10
    local MAX_PER_FRAME,FRAME_BUDGET=128,.002
    local status={state="Ready",active=false,completed=0,total=COUNT,remaining=0,peak_batch=0}
    app.mobility.up=status
    local ready_at,notify_ready,last_clock=0,false,0
    local function remaining(now) return math.max(0,ready_at-now) end
    function app.up_cooldown_service(now)
        if now<last_clock then
            ready_at=now+remaining(last_clock)
            if app.up then app.stop_up("Clock changed") end
        end
        last_clock=now
        status.remaining=remaining(now)
        if not app.up and ready_at>0 and status.remaining==0 then
            ready_at=0;status.state="Ready"
            if notify_ready and not app.stopped then app.toast("Up is ready / cooldown finished") end
            notify_ready=false
        end
    end
    function app.stop_up(reason,quiet)
        local state=app.up
        if not state then return end
        app.up=nil;status.active=false;status.state=reason or "Complete"
        status.elapsed=math.max(0,utility.GetTime()-state.started)
        ready_at=utility.GetTime()+COOLDOWN;status.remaining=COOLDOWN
        notify_ready=not app.stopped
        if not quiet then app.toast("Up / "..status.state.." / "..status.completed.." of 3000 / 10s cooldown") end
    end
    function app.start_up()
        local now=utility.GetTime();app.up_cooldown_service(now)
        if app.stopped then return false,"Script stopped" end
        if app.up then return false,"Up is running" end
        if remaining(now)>0 then
            local reason=string.format("Up cooldown / %.1fs",remaining(now));app.toast(reason);return false,reason
        end
        if ui.capture or ui.search_focus or (app.cursor_ready and not app.cursor_ready()) then
            app.toast("Finish cursor alignment or key capture first");return false,"Input busy"
        end
        local lp=app.me;local char=mobility_read(lp,"Character")
        if not char or not mobility_read(lp,"IsAlive") then app.toast("Up / waiting for character");return false,"No character" end
        -- Restore the previous movement mode before capturing this origin.
        ui.vals.mv_fly=false;ui.vals.spider_on=false
        app.stop_spider("Up active");app.stop_underground()
        local p=mobility_read(lp,"Position")
        if not p or not mobility_number(p.X) or not mobility_number(p.Y) or not mobility_number(p.Z) then
            app.toast("Up / position unavailable");return false,"No position"
        end
        app.up={lp=lp,owner=mobility_owner(char),x=p.X,y=p.Y,z=p.Z,started=utility.GetTime(),
            rise=clamp(app.n("up_rise"),1,3000),count=0}
        status.state="Running";status.active=true;status.completed=0;status.elapsed=0;status.peak_batch=0
        status.error=nil;status.observed_rise=0;status.rise=app.up.rise;status.remaining=0
        ui.open=false;ui.popup=nil;ui.picker=nil;ui.drag=nil
        app.toast("Up started / 3000 teleports over 2s")
        return true
    end
    local function service()
        local state=app.up;if not state then return end
        if not mobility_same(state.lp,state.owner) or not mobility_read(state.lp,"IsAlive") then
            app.stop_up("Character changed");return
        end
        if ui.open or ui.capture or ui.search_focus or not app.cursor_ready() then app.stop_up("Cancelled / menu");return end
        local now=utility.GetTime();local elapsed=now-state.started
        if elapsed<0 then app.stop_up("Clock changed");return end
        -- A delayed callback never starts an unbounded catch-up loop.
        if elapsed>DURATION+.05 then app.stop_up("Partial / frame deadline missed");return end
        local due=math.floor(math.min(elapsed,DURATION)*COUNT/DURATION+.000001)
        local batch=math.min(MAX_PER_FRAME,math.max(0,due-state.count))
        local start=utility.GetTime();local writes=0
        for i=1,batch do
            if utility.GetTime()-start>=FRAME_BUDGET then break end
            local index=state.count+1
            local ok,err=pcall(function()
                state.lp.Position=Vector3.New(state.x,state.y+state.rise*index/COUNT,state.z)
            end)
            if not ok then status.error=tostring(err):sub(1,120);app.stop_up("Position write failed");return end
            state.count=index;writes=writes+1;status.completed=index
        end
        status.peak_batch=math.max(status.peak_batch,writes);status.elapsed=elapsed
        local p=mobility_read(state.lp,"Position")
        if p and mobility_number(p.Y) then status.observed_rise=p.Y-state.y end
        if state.count==COUNT then app.stop_up("Complete")
        elseif elapsed>=DURATION then app.stop_up("Partial / frame budget reached") end
    end
    local original_movement=app.movement
    function app.movement()
        app.up_cooldown_service(utility.GetTime())
