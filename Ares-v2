        local wanted={}; local ordered={}
        if app.v("hud_loadout") and state.data then
            for _,row in ipairs({state.data.top,state.data.bottom}) do
                for i=1,8 do local key=app.item_icon_name(row[i]); if key and not wanted[key] then wanted[key]=true; ordered[#ordered+1]=key end end
            end
        end
        for key,used in pairs(state.requests) do
            if now-used>0.75 then state.requests[key]=nil; state.request_count=state.request_count-1
            elseif app.v("hud_inventory") and not wanted[key] then wanted[key]=true; ordered[#ordered+1]=key end
        end
        local pending=0
        for _,entry in pairs(state.cache) do
            if entry.handle and (entry.status=="pending" or entry.status=="ready" and not entry.confirmed) then
                local has_failed,failed=optional("ImageFailed",entry.handle)
                local has_loaded,loaded=optional("ImageLoaded",entry.handle)
                if has_failed and failed then fail_source(entry,"download/decode failed")
                elseif has_loaded and loaded then entry.status="ready"; entry.confirmed=true; dimensions(entry)
                else
                    dimensions(entry)
                    -- The reference submits every returned handle to Image immediately.
                    -- A false readiness query is not a draw prerequisite in this VM.
                    if entry.status=="pending" and now-entry.started>15 and not entry.timed_out then
                        entry.timed_out=true; image_error(entry.key..": readiness unconfirmed after 15s; still drawing handle")
                    end
                end
            end
            if entry.status=="pending" and not entry.draw_submitted then pending=pending+1 end
        end
        -- Two new textures per frame; four handles may await their first draw submission.
        local started=0
        for _,key in ipairs(ordered) do
            local entry=state.cache[key]
            if not entry and evict(wanted) then
                entry={key=key,status="queued",sources=image_sources(key),source_index=0,used=now}
                state.cache[key]=entry; state.count=state.count+1
            end
            if entry then
                entry.used=now
                if entry.status=="queued" and started<2 and pending<4 then
                    if entry.source_index>=#entry.sources then entry.status="failed"; image_error(key..": no image source")
                    elseif state.resources>=40 then image_error("40 texture limit reached; reload requires VM FreeImage support")
                    else
                        entry.source_index=entry.source_index+1; entry.started=now; entry.draw_submitted=false; entry.timed_out=false
                        local ok,handle=pcall(draw.LoadImage,entry.sources[entry.source_index]); started=started+1
                        if ok and handle~=nil and handle~=false and handle~=0 then
                            own(handle); entry.handle=handle; entry.status="pending"; pending=pending+1
                        else fail_source(entry,ok and "loader returned no handle" or "LoadImage failed: "..tostring(handle)) end
                    end
                end
            end
        end
    end
