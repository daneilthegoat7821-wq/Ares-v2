    end
    if not done then s.status="Scanning / recoil read back"; return s end
    -- Only a finished generation proves that a captured instance left the path.
    -- In-progress scans must never restore still-unvisited weapon values.
    local removed={}
    for id,entry in pairs(pd_recoil_originals) do
        if not cursor.seen[id] then removed[#removed+1]=entry end
    end
    for _,entry in ipairs(removed) do
