local BASE_ROW = {toggle=40,slider=58,combo=44,bind=40,themecolor=40,button=44,note=26,sep=16,swatches=52,stat=28,input_ro=48,preview=250,diagnostics=360}
local function row_h(it)
    local h = BASE_ROW[it.t] or 24
    if it.d then h = h + 13 end
    return h
end
local function group_h(g)
    local h=42
    for _,it in ipairs(g.items) do h=h+row_h(it) end
    return h+10
end



local function hit_h(it, top) return top + (it.d and 13 or 0) end
-- a control accepts input only when its card is essentially settled and no modal is open
local function interactable(ap) return ap>0.9 and not ui.popup and not ui.picker end

local function desc(it,x,y,w,ap)
    if not it.d then return 0 end
    tmid(x,y,13,it.d, a(theme.faint,ap),10); return 13
end

local function w_toggle(it,x,y,w,ap)
    local top=BASE_ROW.toggle
    local val=ui.vals[it.id]
    local hot=inside(x,y,w,hit_h(it,top)) and interactable(ap)
    if hot and ui.mouse.clicked then
        ui.vals[it.id]=not val; ui.mouse.clicked=false; log(it.label.." -> "..tostring(not val))
    end
    local hv=approach("th_"..it.id, hot and 1 or 0, 14)
    tmid(x,y,top,app.fit(it.label,w-145,12), a(mix(theme.text,{1,1,1,1},hv*0.25), ap*(0.86+hv*0.14)),13)
    local pw,ph=34,16
    local px,py=x+w-pw,y+(top-ph)*0.5
    local rv=approach("tg_"..it.id, val and 1 or 0, 16)
    local sp=ease_back(rv)
    if rv>0.02 then soft(px,py,pw,ph,theme.accent,ph*0.5,3,rv*ap) end
    if theme.grad and rv>0.02 then
        draw.RectFilled(px,py,pw,ph, a(mix(theme.field,theme.accent,rv),ap), ph*0.5)
    else
        draw.RectFilled(px,py,pw,ph, a(mix(theme.field,theme.accent,rv),ap), ph*0.5)
    end
    if rv<0.5 then draw.Rect(px,py,pw,ph, a(theme.rail, ap*(1-rv*2)), ph*0.5,1) end
    local kr=(ph-6)*0.5
    draw.CircleFilled(px+3+kr+(pw-ph)*sp, py+ph*0.5, kr, a(mix({0.75,0.76,0.80,1},{1,1,1,1},rv),ap),24)
    return top + desc(it,x,y+top-2,w,ap)
end

local function w_slider(it,x,y,w,ap)
    local top=BASE_ROW.slider
    local val=ui.vals[it.id]
    local scale=it.scale or 1
    local num=it.float and string.format(it.fmt,val*scale) or string.format(it.fmt or "%d",val)
    local disp=num..(it.suffix or "")
    tmid(x,y,16,app.fit(it.label,w-tsize(disp,12)-14,12), a(theme.text,ap*0.9),13)
    tright(x+w,y,16,disp, a(theme.accent,ap),12)
    local tx,ty,tw,th=x,y+21,w,4
    local target=(val-it.min)/(it.max-it.min)
    -- grab zone spans the whole control band (label row through track), full width
    local hot=inside(x,y,w,top-2) and interactable(ap)
    if hot and ui.mouse.clicked and not ui.drag then
        ui.drag={kind="slider",id=it.id,min=it.min,max=it.max,x=tx,w=tw}; ui.mouse.clicked=false
    end
    if ui.drag and ui.drag.kind=="slider" and ui.drag.id==it.id then
        local f=clamp((ui.mouse.x-tx)/tw,0,1)
        ui.vals[it.id]=math.floor(it.min+f*(it.max-it.min)+0.5); target=f
    end
    local fill=approach("sl_"..it.id, target, 18)
    draw.RectFilled(tx,ty,tw,th, a(theme.rail,ap), th*0.5)
    if fill>0.001 then
        local fw=math.max(th,tw*fill)
        soft(tx,ty,fw,th,theme.accent,th*0.5,2,ap*0.7)
        if theme.grad then draw.RectFilled(tx,ty,fw,th, a(mix(theme.accent,theme.accent2,0.5),ap), th*0.5)
        else draw.RectFilled(tx,ty,fw,th, a(theme.accent,ap), th*0.5) end
    end
    local hv=approach("slh_"..it.id, hot and 1 or 0, 14)
    draw.CircleFilled(tx+tw*fill, ty+th*0.5, 5+hv*1.5, a({1,1,1,1},ap),24)
    return top + desc(it,x,y+top-4,w,ap)
end

