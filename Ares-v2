function app.calibration_frame(now,reads)
    local c=app.cursor
    if app.edge(0x52) then
        app.start_calibration("Restarted. Click the first highlighted corner."); c=app.cursor
    end
    if app.edge(0x08) then
        if #c.samples>0 then table.remove(c.samples) end
        if #c.capture_history>0 then table.remove(c.capture_history) end
        c.ready=false;c.phase="sample";c.model=nil;c.models={};c.capture=nil;c.release_gate=nil
        c.step=#c.samples+1;c.armed=false
        c.message="Point removed. Click the highlighted corner again."
    end
    if not ui.mouse.down then c.armed=true end
    if ui.mouse.clicked and c.armed and not c.ready and app.calibration_target_ready() then
        c.armed=false
        if not reads.client and not reads.absolute then
            c.message="Cursor signal unavailable. Release and click again."
        elseif #c.samples<4 then
            local target=c.targets[#c.samples+1]
            local sample={reads=app.copy(reads),target={target[1],target[2]}}
            c.samples[#c.samples+1]=sample
            local entry={step=#c.samples,target=app.copy(sample.target),pressed_at=now,
                press_reads=app.copy(reads),reads=app.copy(reads),outcome="Point captured"}
            c.capture_history[#c.capture_history+1]=entry
            if #c.capture_history>8 then table.remove(c.capture_history,1) end
            c.step=math.min(#c.samples+1,4)
            c.message="Point captured. Click the next highlighted corner."
            if #c.samples==4 then
                c.models={client=app.solve_cursor(c.samples,"client"),absolute=app.solve_cursor(c.samples,"absolute")}
                c.model=c.models.client or c.models.absolute
                if c.models.client and c.models.absolute and c.models.absolute.rms+2<c.models.client.rms then c.model=c.models.absolute end
                entry.models=app.copy(c.models)
                if c.model then
                    c.ready=true;c.phase="ready";c.release_gate=true;c.aligned_at=now
                    c.message="Aligned across your screen.";entry.outcome="Four-point affine fit accepted"
                    ui.open=true;ui.appear=0;ui.drag=nil
                    if app.toast then app.toast("Cursor aligned.") end
                else
                    -- Keep the first three corners so the last point is a fresh retry.
                    table.remove(c.samples);c.models={};c.step=4
                    entry.outcome="Four-point affine fit rejected"
                    c.message="This point did not line up. Click it again, or press R to restart."
                end
            end
        end
    end
    if not c.ready then app.calibration_draw(now) end
    ui.mouse.clicked=false;ui.mouse.rclicked=false
end


