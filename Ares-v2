function app.guard(name,fn)
    local e=app.errors[name]
    if e and e.streak>=3 and utility.GetTime()<(e.next_retry or 0) then return end
    local ok,err=pcall(fn)
    if ok then if e then
        if e.streak>0 then e.recoveries=(e.recoveries or 0)+1 end
        e.streak=0;e.next_retry=nil
    end return end
    e=e or {count=0,streak=0}; e.count=e.count+1; e.streak=e.streak+1
    e.message=tostring(err); app.errors[name]=e
    if e.streak>=3 then e.next_retry=utility.GetTime()+math.min(5,.5*2^math.min(e.streak-3,4)) end
    if e.count==1 or e.streak==3 then
        print("[ARES / "..name.."] "..e.message)
        app.toast(name..(e.streak>=3 and " cooling down; automatic retry" or ": "..e.message:sub(1,64)))
    end
