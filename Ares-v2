function DeltaNova.Set(id,value)
    local it=app.schema[id]
    if not it then return false,"Unknown setting" end
    if it.t=="toggle" then if type(value)~="boolean" then return false,"Expected boolean" end; ui.vals[id]=value
    elseif it.t=="slider" or it.t=="combo" then
        if type(value)~="number" or value~=value or math.abs(value)==math.huge then return false,"Expected finite number" end
        ui.vals[id]=math.floor(clamp(value,it.min or 1,it.max or #it.items)+0.5)
    elseif it.t=="bind" then
        if type(value)~="number" or value~=value or math.abs(value)==math.huge then return false,"Expected virtual key" end
        local ok,reason=app.commit_bind(id,math.floor(clamp(value,0,254)))
        if not ok then return false,reason end
    else return false,"Use the menu for this control" end
    app.last_scan=-100
    return true
end
