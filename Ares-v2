        local source="Observed ObjectValue / "..tag
        if S.kill_source~=source then S.kill_source=source;S.revision=S.revision+1 end
        local killer
        for _,id in ipairs(order) do
            local candidate=entries[id]
            if candidate and candidate.player_address==target and now-candidate.last_seen<=2.5 then killer=candidate;break end
        end
        if not killer or killer==e then unknown_death();return end
        -- Resolve only the current Player ObjectValue; never infer the nearest player.
        local kp=killer.player
        if read(kp,"IsValid")==false or address(read(kp,"Player"))~=target or address(read(kp,"Character"))~=killer.character then
            unknown_death();return
        end
        local kx,ky,kz=xyz(read(kp,"Position"))
        if not kx or not x then unknown_death();return end
        local distance=math.sqrt((kx-x)^2+(ky-y)^2+(kz-z)^2)*.28
        killer.last_kill_distance=distance;killer.last_kill_at=now;killer.kill_source=S.kill_source
        if distance>=number("cf_long_range",100,50,500) then
            killer.streak=killer.streak+1;killer.long_kills=killer.long_kills+1
        else killer.streak=0 end
        S.attributed_kills=S.attributed_kills+1;S.revision=S.revision+1;reason(killer)
    end
    local function sample(p,now)
        local id=uid(p)
        if not id or read(p,"IsValid")==false then return end
        local e=entries[id]
        if not e then
            if #order>=256 then
                local oldest=1
                for i=2,#order do if entries[order[i]].last_seen<entries[order[oldest]].last_seen then oldest=i end end
                drop(oldest)
            end
            e={uid=id,name=tostring(id),display=tostring(id),last_seen=now,streak=0,long_kills=0,
                peak_speed=0,reasons={},reason_signature="",flagged=false,account_status="Pending",kill_source="Unavailable"}
            entries[id]=e;order[#order+1]=id;S.revision=S.revision+1
        end
        local name,display=text(read(p,"Name"),tostring(id)),text(read(p,"DisplayName"),text(read(p,"Name"),tostring(id)))
        if e.name~=name or e.display~=display then S.revision=S.revision+1 end
        e.name=name;e.display=display;e.is_local=read(p,"IsLocal")==true;e.player=p;e.last_seen=now
        e.player_address=address(read(p,"Player"))
        account(e)
        local char,hum=read(p,"Character"),read(p,"Humanoid")
        local character,humanoid=address(char),address(hum)
        if not character or not humanoid or read(char,"Parent")==nil or read(hum,"Parent")==nil then
            speed_reset(e);e.last_hp=nil;e.character=nil;e.humanoid=nil;reason(e);return
        end
        local same=e.character==character and e.humanoid==humanoid
        if not same then
            speed_reset(e);e.last_hp=nil;e.streak=0;e.character=character;e.humanoid=humanoid;S.revision=S.revision+1
        end
        if e.sample_time and now-e.sample_time>2.5 then
            speed_reset(e);e.last_hp=nil;e.streak=0;S.revision=S.revision+1
        end
        local x,y,z=xyz(read(p,"Position"))
        local hp=read(hum,"Health")
        if not finite(hp) then hp=read(p,"Health") end
        local dead=finite(hp) and hp<=0 or read(p,"IsDead")==true
        if same and e.last_hp and e.last_hp>0 and dead and not e.death_seen then
            e.death_seen=true;death(e,p,hum,now,x,y,z)
        end
        if not dead and finite(hp) and hp>0 then e.death_seen=false end
        e.last_hp=finite(hp) and hp or nil
        local vx,vy,vz=xyz(read(p,"Velocity"))
        local dt=e.sample_time and now-e.sample_time or nil
        local speed=x and e.x and dt and dt>0 and math.sqrt((x-e.x)^2+(z-e.z)^2)/dt or nil
        local velocity=vx and math.sqrt(vx*vx+vz*vz) or nil
        local threshold=number("cf_speed",45,25,150)
        local old_speed=e.current_speed
        if dead or not x or not velocity or not dt or dt<.04 or dt>2.5 or math.abs(vy)>35
            or math.sqrt((x-e.x)^2+(y-e.y)^2+(z-e.z)^2)>500 then
            e.speed_since=nil;e.current_speed=nil
        else
            e.current_speed=math.floor(speed*10+.5)/10
            if speed>e.peak_speed then e.peak_speed=math.floor(speed*10+.5)/10 end
            if not e.is_local and read(p,"Sit")~=true and read(hum,"Sit")~=true and speed>threshold and velocity>threshold
                and math.abs(speed-velocity)<=math.max(12,velocity*.4) then
                e.speed_since=e.speed_since or now
                if now-e.speed_since>=number("cf_sustain",1500,500,5000)/1000 and not e.speed_at then
                    e.speed_at=now;S.revision=S.revision+1
                end
            else e.speed_since=nil end
        end
        if old_speed~=e.current_speed then S.revision=S.revision+1 end
        e.x=x;e.y=y;e.z=z;e.sample_time=x and now or nil
        reason(e)
    end
    function app.finder_service(now)
        if app.stopped or not app.v("cf_on") then
            if enabled then enabled=false;app.finder_reset() end
            S.state="Off";return
        end
        enabled=true
        now=now or utility.GetTime()
        if not finite(now) then return end
        if now<last_time then app.finder_reset() end
        last_time=now
        if now<next_poll then return end
        next_poll=now+.25;S.polls=S.polls+1
        local players=app.players or {};local count=#players
        if scan_index>count then scan_index=1 end
        for i=1,math.min(32,count) do
            local p=players[scan_index];scan_index=scan_index+1
            if scan_index>count then scan_index=1 end
            S.checks=S.checks+1;sample(p,now)
        end
        for i=1,math.min(32,#order) do
            if cleanup_index>#order then cleanup_index=1 end
            local e=entries[order[cleanup_index]]
            if e and now-e.last_seen>6 then drop(cleanup_index) else cleanup_index=cleanup_index+1 end
        end
        recount();S.state=count>0 and "Watching players" or "Waiting for players"
    end
    local function public(e)
        return {uid=e.uid,name=e.name,display=e.display,created=e.created,age_days=e.age_days,
            account_status=e.account_status,young=e.young,current_speed=e.current_speed,peak_speed=e.peak_speed,
            streak=e.streak,long_kills=e.long_kills,last_kill_distance=e.last_kill_distance,last_kill_at=e.last_kill_at,
            last_seen=e.last_seen,flagged=e.flagged,reasons=app.copy(e.reasons),speed_at=e.speed_at,kill_source=e.kill_source}
    end
    function app.finder_status() return app.copy(S) end
    function app.finder_rows(offset,limit,only_flagged)
        offset=finite(offset) and math.max(0,math.floor(offset)) or 0
        limit=finite(limit) and math.max(1,math.min(10,math.floor(limit))) or 10
        local list={}
        for _,id in ipairs(order) do
            local e=entries[id]
            if e and not e.is_local and (not only_flagged or e.flagged) then list[#list+1]=e end
        end
        table.sort(list,function(l,r)
            if l.flagged~=r.flagged then return l.flagged end
            if l.name~=r.name then return l.name<r.name end
            return l.uid<r.uid
        end)
        local rows={}
        for i=offset+1,math.min(#list,offset+limit) do rows[#rows+1]=public(list[i]) end
        return rows,#list
    end
    local previous_action=app.action
    function app.action(id)
        if id=="finder_clear" then app.finder_reset();return true end
        if previous_action then return previous_action(id) end
    end
end


