            loaded=stats.loaded,total=#order,attempts=stats.attempts,draws=stats.draws,failures=stats.failures,resources=stats.resources,
            submitted=counts.submitted,unverified=counts.unverified,pending=counts.pending,timeouts=stats.timeouts,last_error=stats.last_error,
            tint_conversions=stats.tint_conversions,tint_hits=stats.tint_hits,status_scans=stats.status_scans}
    end
    local label_revision,label_enabled,label_available,label_failures,label_text
    function app.ui_images_label()
