    function app.clear_silent(disable,force)
        if not app.silent_owned and not app.silent_target_set and not app.silent_tracking and not app.silent_cleanup_pending then return true end
        if not disable and not app.silent_target_set and not app.silent_tracking and not app.silent_cleanup_pending then return true end
        local t=now()
