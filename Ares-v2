-- Aim adapters for the documented Vector API. No offsets or game callbacks.
-- Silent overrides are straight rays; line-of-sight is an estimate, not a hit receipt.
do
    local A={time=-1,rays=0,overlay=0,cache={},owner=nil,next_hook=0,hook_failures=0,next_cleanup=0,cleanup_failures=0,limit=24,overlay_limit=8,
        generation=0,pending={},sequence=0,overlay_allowed={}}
    local EPS=0.000001
    local function finite(n) return type(n)=="number" and n==n and n>-math.huge and n<math.huge end
    local function components(p)
        if not p then return nil end
        local ok,x,y,z=pcall(function() return p.X,p.Y,p.Z end)
        if ok and finite(x) and finite(y) and finite(z) and math.abs(x)<100000000 and math.abs(y)<100000000 and math.abs(z)<100000000 then return x,y,z end
    end
    local function vector(p)
        local x,y,z=components(p)
        if x then return Vector3.New(x,y,z) end
    end
    local function num(id,fallback,lo,hi)
        local n=tonumber(ui.vals[id]); if not finite(n) then n=fallback end
        return math.max(lo or -math.huge,math.min(hi or math.huge,n))
    end
    local function now()
        local ok,t=pcall(utility.GetTime); return ok and finite(t) and t or 0
    end
    local function address(object)
        if not object then return nil end
        local ok,value=pcall(function() return object.Address end)
        return ok and value or nil
    end
    local function same_object(left,right)
        if left==right then return true end
        local aa,bb=address(left),address(right)
        return aa~=nil and bb~=nil and aa==bb
    end
    local configuration={"aim_bone","aim_pool","aim_team","aim_hp","aim_range","aim_prediction","aim_lead",
        "aim_ballistic","aim_drop","aim_bullet_speed","aim_gravity","aim_max_flight","fov_size","aim_origin","aim_priority","aim_sticky","aim_hysteresis","aim_method","aim_delivery"}
    local function configuration_changed()
        local parts={}
        for _,id in ipairs(configuration) do parts[#parts+1]=tostring(ui.vals[id]) end
        local signature=table.concat(parts,":")
        if signature~=A.signature then
            A.signature=signature; A.cache={}; A.scan_cursor=nil; A.record_signature=nil
        end
    end
    function app.begin_aim_frame()
        local t=now()
        if t<A.time then A.next_hook=0;A.next_cleanup=0 end
        A.generation=A.generation+1; A.rays=0; A.overlay=0; A.time=t
        A.metrics={records_seen=0,eligible=0,candidates=0,projected=0,in_fov=0,
            rays_clear=0,rays_blocked=0,rays_unknown=0,rejection_counts={}}
        A.delivery=nil;A.probe_candidate=nil
        local pending={}
        for id,row in pairs(A.pending) do
            if A.time-row.seen>0.25 then A.pending[id]=nil
            else pending[#pending+1]={id=id,order=row.order,time=row.checked or -math.huge} end
        end
        table.sort(pending,function(left,right)
            if left.time~=right.time then return left.time<right.time end
            return left.order<right.order
        end)
        A.overlay_allowed={}
        for i=1,math.min(#pending,A.overlay_limit) do A.overlay_allowed[pending[i].id]=true end
    end
    local original_sync=app.sync
    function app.sync()
        app.begin_aim_frame()
        return original_sync()
    end
    local function frame()
        local t=now()
        A.time=t
        configuration_changed()
        -- Wall-clock changes never replenish the per-sync ray budgets.
        if not A.prune or t-A.prune>1 then
            A.prune=t
            for id,row in pairs(A.cache) do if t-row.time>0.1 then A.cache[id]=nil end end
        end
        return t
    end
    local function ready()
        if not raycast or type(raycast.IsReady)~="function" or type(raycast.IsVisible)~="function" then return false end
        local ok,result=pcall(raycast.IsReady); return ok and result==true
    end
    local function method() return math.floor(num("aim_method",3,1,3)) end
    local function live(r)
        if not r or not r.char or not components(r.pos) then return false end
        if r.entity then
            local ok,valid,alive,char,hp=pcall(function()
                return r.entity.IsValid,r.entity.IsAlive,r.entity.Character,r.entity.Health
            end)
            if not ok or not valid or not alive or not same_object(char,r.char) or (finite(hp) and hp<=0) then return false end
        elseif r.npc then
            local ok,hp=pcall(function() return r.hum and r.hum.Health end)
            if not ok or not finite(hp) or hp<=0 then return false end
        end
        return finite(r.hp) and r.hp>0
    end
    local function local_origin(silent)
        if silent then
            local me=app.me
            if not me or not me.IsAlive then return nil end
            local ok,p=pcall(function() return me.HeadPosition end)
            if ok and components(p) then return vector(p) end
            -- R6/R15 heads share this name. Read position afresh if the entity adapter lags.
            local success,head=pcall(function() return me.Character and me.Character:FindFirstChild("Head") end)
            if success and head then
                local good,pos=pcall(function() return head.Position end)
                if good then return vector(pos) end
            end
            return nil
        end
        local ok,p=pcall(camera.GetPosition)
        return ok and vector(p) or vector(app.cam)
    end
    function app.aim_origin(silent) return local_origin(silent~=false) end
    local function capabilities()
        local result={}
        for _,name in ipairs({"IsReady","IsVisible","Cast","EnableSilentHook","IsSilentHookActive",
            "SetSilentTarget","ClearSilentTarget","TrackSilentTarget","StopSilentTracking","DisableSilentHook"}) do
            result[name]=raycast and type(raycast[name])=="function" or false
        end
        return result
    end
    local function status(state,reason,c)
        local observed=A.metrics or {}
        app.aim_status={state=state,reason=reason or "",method=method(),target=c and c.record.name or nil,
            bone=c and c.bone or nil,distance=c and c.dist or nil,flight=c and c.flight or nil,
            raycasts=A.rays,ray_limit=A.limit,overlay_raycasts=A.overlay,overlay_ray_limit=A.overlay_limit,
            hook=app.silent_owned==true,time=A.time,generation=A.generation,capabilities=capabilities(),
            records_seen=observed.records_seen or 0,eligible=observed.eligible or 0,candidates=observed.candidates or 0,
            projected=observed.projected or 0,in_fov=observed.in_fov or 0,
            rays_clear=observed.rays_clear or 0,rays_blocked=observed.rays_blocked or 0,rays_unknown=observed.rays_unknown or 0,
            rejection_counts=observed.rejection_counts or {},delivery=A.delivery,hook_result=A.hook_result,
            target_call_accepted=A.delivery and A.delivery.accepted or false,cleanup_error=A.cleanup_error,
            hook_failures=A.hook_failures,hook_retry_seconds=math.max(0,A.next_hook-A.time),
            cleanup_retry_seconds=math.max(0,A.next_cleanup-A.time),
            visibility_filter=app.v("aim_visible"),visibility_cache_ready=app.ray_ready==true,
            visibility_cache_error=app.ray_ready_error,
            path_state=c and c.path_state or "not_checked",path_reason=c and c.path_reason or nil}
    end
    status("idle","Aim is off")
    function app.aim_diagnostics()
        local function copy(value)
            if type(value)~="table" then return value end
            local result={};for key,item in pairs(value) do result[key]=copy(item) end;return result
        end
        local out=copy(app.aim_status)
        out.raycasts=A.rays; out.overlay_raycasts=A.overlay
        return out
    end
    function app.fov_origin()
        local ok,x,y
        if num("aim_origin",1)==2 then ok,x,y=pcall(input.GetMousePosition) else ok,x,y=pcall(input.GetScreenCenter) end
        if ok and finite(x) and finite(y) then return x,y end
        local good,w,h=pcall(draw.GetScreenSize)
        if good and finite(w) and finite(h) then return w*0.5,h*0.5 end
        return nil,nil
    end
    local function bone_position(r,name)
        local ok,p=pcall(app.bone,r,name)
        if ok and components(p) then return vector(p) end
        if name=="Head" and r.entity then
            local success,head=pcall(function() return r.entity.HeadPosition end)
            if success then return vector(head) end
        end
        return nil
    end
    function app.aim_bones(r)
        local torso=bone_position(r,"UpperTorso") and "UpperTorso" or "Torso"
        local choice=math.floor(num("aim_bone",4,1,4))
        if choice==1 then return {"Head"} elseif choice==2 then return {torso}
        elseif choice==3 then return {"HumanoidRootPart"} end
        return {"Head",torso,"HumanoidRootPart","LeftUpperArm","RightUpperArm","Left Arm","Right Arm"}
    end
    local function predict(r,pos,origin)
        local x,y,z=components(pos); local ox,oy,oz=components(origin)
        if not x or not ox then return nil,nil,"Invalid world position" end
        local vx,vy,vz=components(r.velocity)
        -- Missing velocity means a stationary estimate, never an invalid vector.
        if not vx or math.abs(vx)>10000 or math.abs(vy)>10000 or math.abs(vz)>10000 then vx,vy,vz=0,0,0 end
        local lead=app.v("aim_prediction") and num("aim_lead",75,0,250)/1000 or 0
        x=x+vx*lead; y=y+vy*lead; z=z+vz*lead
        local travel=0
        if app.v("aim_ballistic") then
            local speed=num("aim_bullet_speed",1800,1,100000)
            local max_time=num("aim_max_flight",4000,250,8000)/1000
            local dx,dy,dz=x-ox,y-oy,z-oz
            local gravity=app.v("aim_drop") and num("aim_gravity",196,0,1000) or 0
            if gravity<=EPS then
                -- Solve |relative position + velocity*t| = projectile speed*t.
                local aa=vx*vx+vy*vy+vz*vz-speed*speed
                local bb=2*(dx*vx+dy*vy+dz*vz)
                local cc=dx*dx+dy*dy+dz*dz
                if cc<=EPS then travel=0
                elseif math.abs(aa)<=EPS then
                    if math.abs(bb)<=EPS then return nil,nil,"No intercept at configured speed" end
                    travel=-cc/bb
