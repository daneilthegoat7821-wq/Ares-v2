            end
        end
    end
    function app.combat_status()
        local result={enabled=C.enabled,tracers=#C.traces,shot_contexts=#C.shots,logs=#C.logs,
            tracked_players=C.hp_count,marker=C.marker~=nil,pulses=C.pulses,correlations=C.correlations,
            health_reads=C.reads,casts=C.casts,resets=C.resets,capacity=24,health_capacity=256,
            health_budget=32,evidence="Local input / replicated HP; not confirmed hits"}
