            local e=entries[id]
            if e and not e.is_local then
                if e.flagged then S.flagged=S.flagged+1 end
                if e.young then S.young=S.young+1 end
            end
        end
    end
    local function reason(e)
        local reasons={}
        if e.speed_at then reasons[#reasons+1]="Review / sustained high speed" end
        if e.streak>=number("cf_long_streak",3,2,10) then
            reasons[#reasons+1]=e.young and ("Young account + "..math.floor(number("cf_long_streak",3,2,10)).." long kills") or "Review / long-range streak"
        end
        local signature=table.concat(reasons,"|")
        if signature~=e.reason_signature then
            local previously=e.flagged
            e.reasons=reasons;e.reason_signature=signature;e.flagged=#reasons>0
            S.revision=S.revision+1
            if e.flagged and not previously and not e.is_local and app.v("cf_notify") and type(app.toast)=="function" then
                app.toast("Cheater Finder / Review "..e.name.." / "..reasons[1])
            end
        end
    end
    local function drop(index)
        local id=order[index]
        if id then entries[id]=nil;table.remove(order,index);S.revision=S.revision+1 end
    end
    function app.finder_reset()
        entries={};order={};scan_index=1;cleanup_index=1;next_poll=0;last_time=0
        S.state=enabled and "Watching players" or "Off";S.retained=0;S.flagged=0;S.young=0
        S.kill_source="Unavailable";S.attributed_kills=0;S.unattributed_deaths=0;S.revision=S.revision+1
    end
    local function account(e)
        if type(app.account_lookup)~="function" then e.account_status="Unavailable";return end
        local ok,a=pcall(app.account_lookup,e.uid)
        if not ok or type(a)~="table" then e.account_status="Unavailable";return end
        local state=text(a.status,"Unavailable")
        local created=type(a.created)=="string" and a.created:sub(1,40) or nil
        local age=finite(a.age_days) and a.age_days>=0 and a.age_days or nil
        local young=age~=nil and age<number("cf_age_days",80,1,365)
        if e.account_status~=state or e.created~=created or e.age_days~=age or e.young~=young then
            e.account_status=state;e.created=created;e.age_days=age;e.young=young
            S.revision=S.revision+1
        end
    end
    local function attacker(hum)
        local find=read(hum,"FindFirstChild")
        if type(find)~="function" then return nil end
        for _,key in ipairs({"creator","Creator","LastAttacker"}) do
            local ok,node=pcall(find,hum,key)
            if ok and node and read(node,"ClassName")=="ObjectValue" then
                local a=address(read(node,"Value"))
                if a then return a,key end
            end
        end
    end
    local function unknown_death()
        S.unattributed_deaths=S.unattributed_deaths+1
        -- An observed death without attribution interrupts certainty about every
        -- player's consecutive-kill sequence. Do not bridge that missing event.
        for _,id in ipairs(order) do
            local e=entries[id]
            if e and e.streak>0 then e.streak=0;S.revision=S.revision+1;reason(e) end
        end
    end
    local function death(e,p,hum,now,x,y,z)
        local target,tag=attacker(hum)
