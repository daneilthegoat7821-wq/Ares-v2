function app.damage_observer()
    local now=utility.GetTime(); local current={}
    local enabled=app.v("hud_damage") or app.v("damage_numbers")
    for _,r in ipairs(app.records) do
        current[r.id]=r.hp
        local previous=app.hp[r.id]
        if enabled and previous and r.hp<previous then
            local delta=previous-r.hp
            app.damage_feed[#app.damage_feed+1]={name=r.name,amount=delta,time=now}
            app.effects[#app.effects+1]={name=r.name,amount=delta,time=now,pos=r.pos}
        end
    end
    app.hp=current
    for i=#app.damage_feed,1,-1 do if now-app.damage_feed[i].time>6 then table.remove(app.damage_feed,i) end end
    for i=#app.effects,1,-1 do if now-app.effects[i].time>1 then table.remove(app.effects,i) end end
    while #app.damage_feed>6 do table.remove(app.damage_feed,1) end
    while #app.effects>32 do table.remove(app.effects,1) end
end
