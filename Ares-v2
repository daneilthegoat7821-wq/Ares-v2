local function capture()
    if not ui.capture then return end
    if not ui.capture_ok then if not input.IsKeyDown(0x01) then ui.capture_ok=true end return end
    if input.IsKeyDown(0x1B) then ui.binds[ui.capture]=0; log("Bind cleared."); ui.capture=nil; return end
    for vk=0x01,0xFE do
        if vk~=0x1B and input.IsKeyDown(vk) then
            ui.binds[ui.capture]=vk; log("Bound "..vk_name(vk).."."); ui.capture=nil; return
        end
    end
end



