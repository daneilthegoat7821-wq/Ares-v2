    return lp and mobility_owner(mobility_read(lp,"Character"))==owner
end
local function mobility_restore(tag)
    local ok,err=pcall(app.restore,tag)
    if not ok then app.mobility.restore_error=tostring(err) end
    return ok
end

local function mobility_parts(char)
    local ok,descendants=pcall(function() return char:GetDescendants() end)
    if ok and type(descendants)=="table" then return descendants end
    -- GetChildren is documented too; this fallback visits the character only.
    local out={}; local stack={char}; local visited={}
    while #stack>0 do
        local node=table.remove(stack)
        local id=mobility_owner(node)
        if not visited[id] then
            visited[id]=true
            local success,children=pcall(function() return node:GetChildren() end)
            if success and type(children)=="table" then
                for _,child in ipairs(children) do out[#out+1]=child; stack[#stack+1]=child end
            end
        end
    end
    return out
end

local function mobility_collisions(state)
    local now=utility.GetTime(); local head_only=app.v("ug_head_only")==true
    if state.collision_mode==head_only and now<(state.next_collision_audit or -100) then return true end
    state.next_collision_audit=now+0.20
