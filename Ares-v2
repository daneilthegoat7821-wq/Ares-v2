    -- Match the loading lockup, with fixed-cost contours and no particles.
    for i=6,1,-1 do
        local spread=i*2*scale
        draw.Rect(x-spread,y-spread,w+spread*2,h+spread*2,mono(.9,.017*(7-i)/6),11*scale+spread,2*scale)
    end
