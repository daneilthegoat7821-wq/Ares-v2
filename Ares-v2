    end
    function app.weapon_observation_prepare(force)
        observation.frame_visits=0;observation.combined_visits=0
        local configuration_key,active=configuration()
        if not active or not alive_and_ready() then
            if observation.token or observation.job then app.weapon_observation_cancel("Weapon controls inactive or character unavailable") end
            return
        end
        local now=utility.GetTime()
        local context=current_context()
        if not context then
            observation.job=nil;observation.cycle=nil;observation.token=nil
            observation.report_verified=false
            observation.status="Waiting for a validated held recoil definition"
            return
        end
        local token=context_token(context,configuration_key)
        if token~=observation.token then
            observation.token=token;observation.context=context;observation.configuration=configuration_key
            observation.changed_at=now;observation.job=nil;observation.cycle=nil
            observation.baseline=nil;observation.audit=nil;observation.last_cycle_result=nil;observation.baseline_pending=true
            observation.pending_file=false;observation.report_verified=false;observation.report_error=nil
            observation.status="Waiting for the held traversal"
            observation.last_audit=-100;observation.last_cycle=-100
        else observation.context=context end
        local down=not ui.open and not ui.capture and not ui.search_focus
            and input and type(input.IsKeyDown)=="function" and input.IsKeyDown(0x01)==true
        if down and not observation.last_lmb and now-observation.last_cycle>=0.5 and not observation.cycle then
            observation.input_edges=observation.input_edges+1;observation.last_cycle=now
            observation.report_verified=false
            observation.cycle={started=now,token=token,stage="before",fire_input=true,confirmed_shot=false}
            -- A pending baseline can wait for this more informative input pair.
            observation.job=nil;start_job("before_fire_input",false,now)
        end
        observation.last_lmb=down
        local cycle=observation.cycle
        if not observation.job and cycle then
            if cycle.stage=="after_100ms" and now-cycle.started>=0.1 then start_job("after_100ms",true,now)
            elseif cycle.stage=="after_300ms" and now-cycle.started>=0.3 then start_job("after_300ms",true,now) end
        end
        if not observation.job and not cycle and down and now-observation.last_audit>=0.2 then
            observation.last_audit=now;start_job("held_fire_input_audit",true,now)
        end
        if not observation.job and not cycle and observation.baseline_pending then
            local direct=app.pd_weapon_status or {}
            if app.v("bs_no_recoil")~=true or direct.complete or now-observation.changed_at>=2 then
