    c.last_reads=reads or {}; c.last_read_at=utility.GetTime()
    if not c.ready then return end
    local x,y=app.cursor_position(reads)
    if not x then app.start_calibration("Cursor input changed. Let's realign."); return end
    -- As in the original four-corner flow, prefer the client fit. A desktop
    -- fit only uses the independently fitted client source to detect a move.
    if c.model.source=="absolute" and c.models.client and reads.client then
        local cx,cy=app.map_cursor(c.models.client,reads.client[1],reads.client[2])
        c.witness_error=math.sqrt((cx-x)^2+(cy-y)^2)
        if c.witness_error>30 then
