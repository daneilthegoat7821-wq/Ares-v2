                local suffix="?rev="..entry.spec.hash.."."..epoch.."."..generation.."."..entry.index
                entry.source="GitHub"
                local url=base..key..".png"..suffix
                local ok,handle=pcall(draw.LoadImage,url)
                if ok and handle and handle~=0 then entry.handle=handle;stats.resources=stats.resources+1;entry.error=nil;changed()
