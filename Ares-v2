    end
    function app.aim_report()
        D.last_attempt=time();D.verified=false;D.error=nil
        local directory=tostring(app.profile_directory or "configs"):gsub("[\\/]+$","")
        if directory=="" then directory="." end
        D.path=directory.."/aim-diagnostics.txt"
