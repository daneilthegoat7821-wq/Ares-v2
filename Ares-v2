    local structural = {attachments=true,loadedammo=true,properties=true,connections=true,inventory=true,items=true,hotbar=true}
    local function collect(folder, counts, budget, depth)
        if not folder or depth > 4 or budget.left <= 0 then return end
        local list = children(folder)
        for i = 1, math.min(#list, 64) do
            if budget.left <= 0 or budget.unique >= 48 then break end
            budget.left = budget.left - 1
            local obj = list[i]
            local name = property(obj,"Name") or ""
            local low = name:lower()
            local class = property(obj,"ClassName") or ""
            if not structural[low] and not low:find("keychain",1,true) and not low:find("estonian",1,true) then
                local item, item_holder
                if class == "StringValue" or class == "ObjectValue" then item = slot_name(obj)
                elseif class == "Model" or class == "Tool" then item = app.item_name(name)
                elseif class == "Folder" and app.item_category(name) ~= "misc" then item = app.item_name(name) end
                if not item or tonumber(item) or item:match("^Slot%d+") or item:match("^Item%d+") then
                    item = slot_name(child(obj,"ItemName")) or slot_name(child(obj,"Item")) or slot_name(child(obj,"Value"))
                    item_holder = item ~= nil
                end
                if item and not tonumber(item) and not item:match("^Slot%d+") and not item:match("^Item%d+") then
                    if not counts[item] then budget.unique = budget.unique + 1 end
                    counts[item] = (counts[item] or 0) + 1
                end
                local nested = child(obj,"Inventory") or child(obj,"Items")
                if nested then collect(nested, counts, budget, depth+1)
                elseif class == "Folder" and not item_holder then collect(obj, counts, budget, depth+1) end
            elseif low == "inventory" or low == "items" or low == "hotbar" then
                collect(obj, counts, budget, depth+1)
            end
        end
    end
    local function list_counts(counts)
        local names = {}
        for name in pairs(counts) do names[#names+1] = name end
        table.sort(names,function(a,b)
            local ap,bp=app.item_is_priority(a),app.item_is_priority(b)
            if ap~=bp then return ap end
            return a:lower()<b:lower()
        end)
        local out = {}
        for _, name in ipairs(names) do out[#out+1] = name..(counts[name]>1 and (" x"..counts[name]) or "") end
        return out
    end
    function app.item_inventory(model)
        local counts = {}
        local folder = child(model,"Inventory") or child(model,"Items")
        if not folder and structural[(property(model,"Name") or ""):lower()] then folder = model end
        collect(folder,counts,{left=160,unique=0},0)
        return list_counts(counts)
    end

    local cache = {}
    local cache_count = 0
    local refresh_frame=-1
    local refresh_queue,queued,queue_head={},{},1
    local stats={refreshes=0,deferred=0,cache_count=0}
    function app.item_metadata_status() return {refreshes=stats.refreshes,deferred=stats.deferred,cache_count=cache_count} end
    local clothing_keys = {"ClothingHeadware","ClothingMask","ClothingChestRig","ClothingShirt","ClothingBackpack","ClothingLegArmor","ClothingPants","ClothingGloves"}
    local hotbar_keys = {"ItemBack1","ItemBack2","ItemHip1","Hotbar4","Hotbar5","Hotbar6","Hotbar7"}
    function app.item_details(player_or_record)
        local player = property(player_or_record,"entity") or player_or_record
        local name = property(player,"Name") or property(player_or_record,"name") or ""
        local char = property(player,"Character") or property(player_or_record,"char")
        local key = name..":"..tostring(property(char,"Address") or char or "none")
        local now = utility.GetTime()
        local old = cache[key]
        if old then old.used=now end
        if old and now-old.time < 1 then return old end
        if not queued[key] then refresh_queue[#refresh_queue+1]=key;queued[key]={seen=now}
        else queued[key].seen=now end
        while queue_head<=#refresh_queue do
            local first=refresh_queue[queue_head];local pending=queued[first]
            if pending and now-pending.seen<=.5 then break end
            queued[first]=nil;refresh_queue[queue_head]=false;queue_head=queue_head+1
        end
        if queue_head>128 then
            local remaining={};for index=queue_head,#refresh_queue do remaining[#remaining+1]=refresh_queue[index] end
            refresh_queue=remaining;queue_head=1
        end
        -- Distribute inventory refreshes across render frames; retain old labels
        -- while waiting. A player scan still retains the original 160-node cap.
        local frame=app.performance and app.performance.frame_serial or math.floor(now*60)
        if frame==refresh_frame or refresh_queue[queue_head]~=key then
            stats.deferred=stats.deferred+1
            if old then return old end
            if cache_count>=256 then
                local victim,used
                for candidate,row in pairs(cache) do if not used or (row.used or row.time)<used then victim,used=candidate,row.used or row.time end end
                if victim then cache[victim]=nil;cache_count=cache_count-1 end
            end
            local pending={name=name,clothing={},hotbar={},inventory={},time=-100,used=now,equipped=app.item_name(property(player,"ToolName")),pending=true}
            cache[key]=pending;cache_count=cache_count+1;return pending
        end
        queued[key]=nil;refresh_queue[queue_head]=false;queue_head=queue_head+1
        refresh_frame=frame;stats.refreshes=stats.refreshes+1
        if cache_count>=256 and not old then
            local victim,used
            for candidate,row in pairs(cache) do if not used or (row.used or row.time)<used then victim,used=candidate,row.used or row.time end end
            if victim then cache[victim]=nil;cache_count=cache_count-1 end
        end
        local data = {name=name,clothing={},hotbar={},inventory={},time=now,used=now,equipped=app.item_name(property(player,"ToolName"))}
        local clothing = child(char,"Clothing")
        for _, field in ipairs(clothing_keys) do data.clothing[field] = slot_name(child(clothing,field)) end
        local rep = property(game,"ReplicatedStorage")
        local pdata = child(child(rep,"Players"),name)
        local status = child(pdata,"Status")
        local variables = child(status,"GameplayVariables") or child(pdata,"GameplayVariables")
        data.equipped = slot_name(child(variables,"EquippedTool")) or data.equipped
        local hotbar = child(variables,"Hotbar")
        for _, field in ipairs(hotbar_keys) do data.hotbar[field] = slot_name(child(hotbar,field)) end
        local counts, budget = {}, {left=160,unique=0}
        local inventory = child(pdata,"Inventory") or child(variables,"Inventory") or child(char,"Inventory") or child(char,"Items")
        collect(inventory,counts,budget,0)
        -- Hotbar entries may also be represented in Inventory: add only missing names.
        for _, field in ipairs(hotbar_keys) do
            local item = data.hotbar[field]
            if item and not counts[item] and budget.unique < 48 then counts[item]=1; budget.unique=budget.unique+1 end
        end
        data.inventory = list_counts(counts)
        data.helmet = data.clothing.ClothingHeadware
        data.vest = data.clothing.ClothingChestRig
        data.backpack = data.clothing.ClothingBackpack
        for _, item in ipairs(data.inventory) do
            if app.item_category(item)=="special" and app.item_is_priority(item) then data.valuable=app.item_name(item); break end
        end
        if not old then cache_count=cache_count+1 end
        cache[key]=data
        return data
    end
    function app.item_target()
        if app.target and app.target.record and not app.target.record.npc then return app.target.record end
        local sw,sh=draw.GetScreenSize()
        local best,score
        for i=1,math.min(#app.records,128) do
            local r=app.records[i]
            if not r.npc and r.pos and not (app.v("esp_team") and r.team) then
                local sx,sy,on=draw.WorldToScreen(r.pos.X,r.pos.Y+3,r.pos.Z)
                if on then
                    local dx,dy=sx-sw/2,sy-sh/2
                    local d=dx*dx+dy*dy
                    if not score or d<score then best,score=r,d end
                end
            end
        end
        return best
    end
    function app.item_esp_annotations(r,b,by,color)
        if r.npc or not (app.v("esp_armor") or app.v("esp_valuable")) then return by end
        local data=app.item_details(r)
        if app.v("esp_armor") then
            local label={}
            if data.helmet then label[#label+1]="Head: "..data.helmet end
            if data.vest then label[#label+1]="Vest: "..data.vest end
            if #label>0 then app.center_text(b.x+b.w/2,by,app.fit(table.concat(label," / "),210,10),raw(color,0.85),10); by=by+13 end
        end
        if app.v("esp_valuable") and data.valuable then
            app.center_text(b.x+b.w/2,by,app.fit("Priority: "..data.valuable,190,10),raw(theme.accent2,0.95),10)
            by=by+13
        end
        return by
    end
    function app.inventory_draw()
        if not app.v("hud_inventory") then return end
        local r=app.item_target()
        if not r then app.panel("inventory","INVENTORY",{{"Target","No player on screen"}},300); return end
        local data=app.item_details(r)
        local rows={{"Player",r.display and r.display~="" and r.display or r.name}}
        if data.equipped then rows[#rows+1]={"Equipped",data.equipped,theme.accent,data.equipped} end
        local limit=clamp(app.n("inventory_limit"),4,16)
        local shown=0
        for _, item in ipairs(data.inventory) do
            if not app.v("inventory_priority") or app.item_is_priority(item) then
                shown=shown+1
                if shown<=limit then rows[#rows+1]={item,app.item_category(item),app.item_is_priority(item) and theme.accent2 or theme.sub,app.item_name(item)} end
            end
        end
        if shown==0 then rows[#rows+1]={"Items","No replicated items"}
        elseif shown>limit then rows[#rows+1]={"Additional items",tostring(shown-limit)} end
        app.panel("inventory","INVENTORY",rows,300)
    end
end


-- Resumable discovery over the same source folders and limits as app.scan.
-- Publish a complete snapshot atomically; overlays retain the previous result
-- while this job crosses frames. No coroutine library or whole-world walk.
do
    local FRAME_VISITS=64
    local generation=0
    app.world_scan_job=nil
    app.world_scan_status={running=false,frame_visits=0,frame_budget=FRAME_VISITS,
        visited=0,generation=0,completed_generation=0,errors=0,phase="Idle"}
    local structural={attachments=true,loadedammo=true,properties=true,connections=true,
        inventory=true,items=true,hotbar=true}

    local function read(object,field)
        if not object then return nil end
        local ok,value=pcall(function() return object[field] end)
        if ok then return value end
    end
    local function child(object,name)
        if not object then return nil end
        local ok,value=pcall(function() return object:FindFirstChild(name) end)
        if ok then return value end
    end
    local function of_class(object,class)
        if not object then return nil end
        local ok,value=pcall(function() return object:FindFirstChildOfClass(class) end)
        if ok then return value end
    end
    local function children(object,job)
        if not object then return {} end
        local ok,value=pcall(function() return object:GetChildren() end)
        if ok and type(value)=="table" then return value end
        job.errors=job.errors+1
        return {}
    end
    local function is_part(object)
        if not object then return false end
        local ok,value=pcall(function() return object:IsA("BasePart") end)
        return ok and value==true
    end
    local function first_part(object)
        if is_part(object) then return object end
        local ok,value=pcall(function() return object:FindFirstChildWhichIsA("BasePart") end)
        return (ok and value) or child(object,"HumanoidRootPart")
    end
    local function wants_all_npcs()
        return app.v("npc_on") or app.v("hud_boss") or (app.v("aim_on") and app.n("aim_pool")~=1)
    end
    local function wants_npcs()
        return wants_all_npcs() or app.v("boss_spawn_alert") or app.v("boss_near_alert")
    end
    local function settings_signature()
        local values={tostring(wants_npcs()),tostring(wants_all_npcs())}
        for _,kind in ipairs({"extracts","items","corpses","containers","quests","claymores"}) do
            values[#values+1]=tostring(app.v("world_"..kind)==true)
        end
        for _,id in ipairs({"hud_loot","world_contents","world_hide_trash"}) do
            values[#values+1]=tostring(app.v(id)==true)
        end
        values[#values+1]=tostring(app.n("world_contents_limit"))
        values[#values+1]=tostring(app.n("world_item_filter"))
        return table.concat(values,":")
    end
    local function next_object(stack)
        while #stack>0 do
            local frame=stack[#stack]
            if frame.index<=frame.limit then
                local object=frame.list[frame.index]
                frame.index=frame.index+1
                return object,frame.depth
            end
            stack[#stack]=nil
        end
    end
    local function push_children(stack,object,depth,limit,job)
        local list=children(object,job)
        stack[#stack+1]={list=list,index=1,limit=math.min(#list,limit or #list),depth=depth}
    end
    local function item_name(value)
        local name=type(value)=="string" and value or read(value,"Name")
        if app.item_name then return app.item_name(name) end
        return type(name)=="string" and name~="" and name or nil
    end
    local function slot_name(object) return item_name(read(object,"Value")) end
    local function item_priority(name) return app.item_is_priority and app.item_is_priority(name) or false end

    local function finish_inventory(job)
        local inventory=job.inventory
        local contents={}
        if inventory.raw then contents=inventory.raw
        else
            local names={}
            for name in pairs(inventory.counts) do names[#names+1]=name end
            table.sort(names,function(left,right)
                local a,b=item_priority(left),item_priority(right)
                if a~=b then return a end
                return left:lower()<right:lower()
            end)
            for _,name in ipairs(names) do
                contents[#contents+1]=name..(inventory.counts[name]>1 and (" x"..inventory.counts[name]) or "")
            end
        end
        for index=1,math.min(#contents,128) do
            local value=contents[index]
            local name=type(value)=="string" and value or read(value,"Name")
            if name and (not app.item_passes_filter or app.item_passes_filter(name)) then
                job.pending_marker.contents[#job.pending_marker.contents+1]=name
                if #job.pending_marker.contents>=app.n("world_contents_limit") then break end
            end
        end
        job.markers[#job.markers+1]=job.pending_marker
        job.pending_marker=nil;job.inventory=nil;job.phase="markers"
    end
    local function inventory_step(job)
        local inventory=job.inventory
        if inventory.raw then
            finish_inventory(job)
            return false
        end
        if inventory.left<=0 or inventory.unique>=48 then finish_inventory(job);return false end
        local object,depth=next_object(inventory.stack)
        if not object then finish_inventory(job);return false end
        inventory.left=inventory.left-1
        local name=read(object,"Name") or ""
        local low=name:lower()
        local class=read(object,"ClassName") or ""
        if not structural[low] and not low:find("keychain",1,true) and not low:find("estonian",1,true) then
            local item,holder
            if class=="StringValue" or class=="ObjectValue" then item=slot_name(object)
            elseif class=="Model" or class=="Tool" then item=item_name(name)
            elseif class=="Folder" and app.item_category(name)~="misc" then item=item_name(name) end
            if not item or tonumber(item) or item:match("^Slot%d+") or item:match("^Item%d+") then
                item=slot_name(child(object,"ItemName")) or slot_name(child(object,"Item")) or slot_name(child(object,"Value"))
                holder=item~=nil
            end
            if item and not tonumber(item) and not item:match("^Slot%d+") and not item:match("^Item%d+") then
                if not inventory.counts[item] then inventory.unique=inventory.unique+1 end
                inventory.counts[item]=(inventory.counts[item] or 0)+1
            end
            if depth<4 then
                local nested=child(object,"Inventory") or child(object,"Items")
                if nested then push_children(inventory.stack,nested,depth+1,64,job)
                elseif class=="Folder" and not holder then push_children(inventory.stack,object,depth+1,64,job) end
            end
        elseif depth<4 and (low=="inventory" or low=="items" or low=="hotbar") then
            push_children(inventory.stack,object,depth+1,64,job)
        end
        return true
    end
    local function source_enabled(kind)
        return app.v("world_"..kind) or (kind=="items" and (app.v("world_corpses") or app.v("hud_loot")))
    end
    local function new_job(signature)
        generation=generation+1
        local workspace=read(game,"Workspace")
        local ai=child(workspace,"AiZones")
        local no_collision=child(workspace,"NoCollision")
        local spawns=child(no_collision,"LootSpawns")
        local job={generation=generation,signature=signature,phase="npc",visited=0,errors=0,
            npcs={},markers={},boss_rows={},seen={},npc_left=2000,npc_stack={},sources={},source_index=1,
            wants_npc=ai~=nil and wants_npcs(),full_npc=wants_all_npcs(),boss_health={},npc_available=ai~=nil,npc_complete=true,
            world=tostring(read(workspace,"Address") or workspace)}
        if ai and job.wants_npc then
            job.npc_stack={{list={ai},index=1,limit=1,depth=0}}
        end
        local function source(kind,parent,name)
            if source_enabled(kind) then
                local folder=child(parent,name)
                if folder then job.sources[#job.sources+1]={kind=kind,folder=folder} end
            end
        end
        source("extracts",no_collision,"ExitLocations")
        source("extracts",workspace,"Extracts")
        source("extracts",workspace,"ExitLocations")
        source("items",workspace,"DroppedItems")
        source("items",workspace,"RuntimeItems")
        source("items",workspace,"Drops")
        source("containers",workspace,"Containers")
        source("containers",workspace,"LootContainers")
        source("containers",spawns,"Crates")
        source("containers",spawns,"Open")
        source("quests",workspace,"QuestItems")
        source("claymores",ai,"Claymores")
        if not workspace then job.phase="complete" end
        return job
    end
    local function finish_npcs(job)
        if job.wants_npc then
            for name in pairs(app.bosses) do
                if name~="Scavking" then
                    local health=job.boss_health[name:lower()]
                    job.boss_rows[#job.boss_rows+1]={name,health and string.format("%d HP",health) or "Not found"}
                end
            end
            table.sort(job.boss_rows,function(left,right) return left[1]<right[1] end)
        end
        job.phase="source_prepare"
    end
    local function step(job)
        if job.phase=="npc" then
            if job.npc_left<=0 then job.npc_complete=false;finish_npcs(job);return false end
            local object,depth=next_object(job.npc_stack)
            if not object then finish_npcs(job);return false end
            job.npc_left=job.npc_left-1
            if read(object,"ClassName")=="Model" then
                local hum=of_class(object,"Humanoid")
                local root=child(object,"HumanoidRootPart") or child(object,"Head")
                local health=read(hum,"Health")
                local name=read(object,"Name") or "NPC"
                local boss=(app.boss_name and app.boss_name(name)~=nil) or app.bosses[name] or false
                if hum and root and type(health)=="number" and health>0 and #job.npcs<256 and (job.full_npc or boss) then
                    local record={id="npc:"..tostring(read(object,"Address")),name=name,char=object,hum=hum,root=root,
                        parts={},npc=true,team=false,boss=boss}
                    job.npc_pending={record=record,list=children(object,job),index=1,health=health}
                    job.phase="npc_parts"
                    return true
                end
            end
            if depth<4 then push_children(job.npc_stack,object,depth+1,nil,job) end
            return true
        elseif job.phase=="npc_parts" then
            local pending=job.npc_pending
            local object=pending.list[pending.index]
            if not object then
                job.npcs[#job.npcs+1]=pending.record
                local key=pending.record.name:lower()
                if not job.boss_health[key] then job.boss_health[key]=pending.health end
                job.npc_pending=nil;job.phase="npc";return false
            end
            pending.index=pending.index+1
            if is_part(object) then
                local name=read(object,"Name")
                if type(name)=="string" then pending.record.parts[name]=object end
            end
            return true
        elseif job.phase=="source_prepare" then
            if #job.markers>=600 then job.phase="complete";return false end
            local source=job.sources[job.source_index]
            if not source then job.phase="complete";return false end
            source.direct=children(source.folder,job);source.direct_count=#source.direct
            source.list={};source.nested={};source.pre_index=1;source.marker_index=1;source.expansion=nil
            job.source=source;job.phase="source_prepass";return false
        elseif job.phase=="source_prepass" then
            local source=job.source
            local expansion=source.expansion
            if expansion then
                if expansion.index>expansion.limit then source.expansion=nil;return false end
                source.nested[#source.nested+1]=expansion.list[expansion.index]
                expansion.index=expansion.index+1
                return true
            end
            if source.pre_index>math.min(source.direct_count,500) then
                for _,object in ipairs(source.nested) do source.list[#source.list+1]=object end
                job.phase="markers";return false
            end
            local object=source.direct[source.pre_index];source.pre_index=source.pre_index+1
            source.list[#source.list+1]=object
            local capacity=500-source.direct_count-#source.nested
            if capacity>0 and read(object,"ClassName")=="Folder" then
                local list=children(object,job)
                source.expansion={list=list,index=1,limit=math.min(#list,100,capacity)}
            end
            return true
        elseif job.phase=="markers" then
            if #job.markers>=600 then job.phase="complete";return false end
            local source=job.source
            local object=source.list[source.marker_index]
            if not object then job.source_index=job.source_index+1;job.phase="source_prepare";return false end
            source.marker_index=source.marker_index+1
            local part=first_part(object)
            local id=tostring(read(object,"Address") or object)
            if part and not job.seen[id] then
                job.seen[id]=true
                local kind=source.kind
                local name=read(object,"Name") or "Item"
                local hum=kind=="items" and of_class(object,"Humanoid")
                local health=read(hum,"Health")
                if kind=="items" and (name:lower():find("corpse",1,true) or (type(health)=="number" and health<=0)) then kind="corpses" end
                local marker={kind=kind,name=name,part=part,contents={}}
                if (kind=="containers" or kind=="corpses") and app.v("world_contents") then
                    local inventory=child(object,"Inventory") or child(object,"Items")
                    if inventory then
                        job.pending_marker=marker
                        job.inventory={counts={},left=160,unique=0,stack={}}
                        if app.item_inventory then
                            local folder=child(inventory,"Inventory") or child(inventory,"Items")
                            if not folder and structural[(read(inventory,"Name") or ""):lower()] then folder=inventory end
                            push_children(job.inventory.stack,folder,0,64,job)
                        else job.inventory.raw=children(inventory,job) end
                        job.phase="inventory"
                        return true
                    end
                end
                job.markers[#job.markers+1]=marker
            end
            return true
        elseif job.phase=="inventory" then return inventory_step(job) end
        return false
    end
    function app.cancel_world_scan()
        app.world_scan_job=nil
        app.world_scan_status.running=false;app.world_scan_status.phase="Cancelled"
    end
    function app.scan()
        local signature=settings_signature()
        local job=app.world_scan_job
        if not job or job.signature~=signature then
            job=new_job(signature);app.world_scan_job=job
        end
        local visits=0
        while visits<FRAME_VISITS and job.phase~="complete" do
            if step(job) then visits=visits+1;job.visited=job.visited+1 end
        end
        local status=app.world_scan_status
        status.frame_visits=visits;status.visited=job.visited;status.generation=job.generation
        status.phase=job.phase;status.errors=job.errors;status.running=job.phase~="complete"
        if job.phase=="complete" then
            app.npcs=job.npcs;app.markers=job.markers;app.boss_rows=job.boss_rows
            status.completed_generation=job.generation;status.phase="Complete"
            status.npc_observed=job.wants_npc;status.npc_available=job.npc_available
            status.npc_complete=job.npc_complete and job.errors==0;status.world=job.world
            app.world_scan_job=nil
            return true
        end
        return false
    end
end


-- Observe the bounded AI snapshot; never walk the world from the alert service.
do
    local names={anton="Anton",dozer="Dozer",whisper="Whisper",death="Death",scavking="Scav King"}
    function app.boss_name(name)
        if type(name)~="string" then return nil end
        return names[name:lower():gsub("[%s_%-]","")]
    end
    local rows={};local row_count=0
    local next_poll,next_toast,last_time=0,0,0
    local world,enabled
    local status={state="Waiting for AI",tracked=0,nearby=0,notifications=0,polls=0,record_checks=0}
    local function read(object,key)
        if not object then return nil end
        local ok,value=pcall(function() return object[key] end)
        if ok then return value end
    end
    local function finite(value) return type(value)=="number" and value==value and math.abs(value)<math.huge end
    local function xyz(value)
        local x,y,z=read(value,"X"),read(value,"Y"),read(value,"Z")
        if finite(x) and finite(y) and finite(z) then return x,y,z end
    end
    local function position(record)
        local health=read(record.hum,"Health")
        if not finite(health) or health<=0 or read(record.char,"Parent")==nil or read(record.root,"Parent")==nil then return nil end
        return xyz(read(record.root,"Position"))
    end
