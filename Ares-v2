    end
    local original_interlock=app.movement_interlock
    function app.movement_interlock(reason)
        app.stop_up(reason or "Cancelled",true)
        return original_interlock(reason)
    end
    local original_action=app.action
    function app.action(id)
        if id=="up_start" then return app.start_up()
        elseif id=="up_cancel" then app.stop_up("Cancelled");return true end
        return original_action(id)
    end
    BASE_ROW.up_status=74
    W.up_status=function(it,x,y,w,ap)
        local rows={status.active and "UP / RUNNING" or status.remaining>0 and string.format("UP / COOLDOWN %.1fs",status.remaining) or "UP / READY",
            string.format("%d / 3000 teleports | %.2fs / 2s",status.completed,status.elapsed or 0),
            status.error or (status.remaining>0 and "ARES will notify when ready" or status.state=="Ready" and "Press your Up key to start" or status.state)}
        for i,line in ipairs(rows) do tmid(x,y+(i-1)*18,18,app.fit(line,w,10),a(theme.sub,ap),10) end
        local fraction=status.active and status.completed/COUNT or status.remaining>0 and 1-status.remaining/COOLDOWN or 1
        draw.RectFilled(x,y+59,w,2,a(theme.line,ap),1)
        if fraction>0 then draw.RectFilled(x,y+59,w*clamp(fraction,0,1),2,a(theme.accent,ap*.75),1) end
        return BASE_ROW.up_status
    end
end


