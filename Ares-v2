-- This module has no GC table discovery or legacy weapon modifications.
app.recoil_evidence={last_action=-100,report_path=nil,report_verified=false,last_error=nil}
local function weapon_report_read(path)
    if type(app.profile_read)~="function" then return nil,"Profile reader unavailable" end
