                A.delivery={mode="per_frame",accepted=ok,result=ok and type(result) or tostring(result):sub(1,110),time=A.time}
                if not ok then A.next_hook=A.time+.25;return stop("Silent target update failed: "..tostring(result):sub(1,90),"unavailable",true) end
