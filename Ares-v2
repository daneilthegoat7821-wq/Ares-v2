            end
        end
    end
    local function snapshot_lines(lines,label,snapshot)
        if not snapshot then lines[#lines+1]=label..": not observed yet";return end
        lines[#lines+1]=label..": started="..weapon_report_value(snapshot.started).." completed="..weapon_report_value(snapshot.completed)
            .." since_fire_input="..weapon_report_value(snapshot.input_time and snapshot.completed-snapshot.input_time)
        lines[#lines+1]="  mode="..snapshot.mode.." checked="..snapshot.checked.." matches_before="..snapshot.matched_before
            .." matches_after="..snapshot.matched_after.." mismatches_before="..snapshot.mismatched
            .." uncaptured="..snapshot.unmapped.." partial="..tostring(snapshot.partial)
        lines[#lines+1]="  mismatch_writes="..snapshot.attempts.." writes_read_back="..snapshot.verified_writes
            .." failed_or_unreadable="..snapshot.failed.." visits="..snapshot.visits
        for index=1,math.min(8,#snapshot.samples) do
            local sample=snapshot.samples[index]
            lines[#lines+1]="  "..sample.path.." original="..weapon_report_value(sample.original)
                .." target="..weapon_report_value(sample.target).." before="..weapon_report_value(sample.before)
                .." after="..weapon_report_value(sample.after).." captured="..tostring(sample.captured)
        end
    end
    function app.weapon_observation_text()
        local name,version=build_stamp()
        local context=observation.context or {}
        local direct=app.pd_weapon_status or {}
        local lines={name.." - automatic held weapon observation", "Schema: 3 / recoil-input-observer-2",
            "Build: "..version,"Session: "..observation.session,"Runtime seconds: "..tostring(utility.GetTime()),
            "Recoil field maintenance: observed; game shot results are not measured.",
            "Fire input is observed; actual game shots and weapon-handler execution are unverified.",
            "Automatic observation performs no getgc, refreshgc, setgc, applygc, or dumpgc calls.",
            "Held mismatch maintenance writes only values already captured by the enabled recoil adapter.",
            "Only recoil is maintained; no legacy gun patches or GC discovery run.",
            "Replicated equipped name: "..weapon_report_value(context.held),
            "Actual definition: "..weapon_report_value(context.name).." | identity="..weapon_report_value(context.id),
            "Actual source: "..weapon_report_value(context.source).." | character="..weapon_report_value(context.owner),
            "Configuration: "..weapon_report_value(observation.configuration),
            "Traversal: "..weapon_report_value(direct.status).." | held="..weapon_report_value(direct.held_verified).."/"..weapon_report_value(direct.held_numeric),
            "Held path: "..weapon_report_value(direct.held_path),
            "File policy: first eligible equip/config observation, then at most one automatic write per 20 seconds.",
            "Input edges observed: "..observation.input_edges,""}
