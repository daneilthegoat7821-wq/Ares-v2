    local function ray(origin,point,overlay,reserve)
        if not ready() or not components(origin) or not components(point) then return "unknown","Raycast data unavailable" end
        if overlay then
            if A.overlay>=A.overlay_limit then return "unknown","Visibility budget deferred" end
            A.overlay=A.overlay+1
