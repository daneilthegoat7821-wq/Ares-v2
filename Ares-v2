        if now<last_time then for _,entry in ipairs(order) do entry.poll=0;entry.next_try=0 end end
        last_time=now
        if not draw or type(draw.LoadImage)~="function" or type(draw.Image)~="function" then return end
        for _,entry in ipairs(order) do
            if entry.handle and not entry.ready and not entry.retained and now>=(entry.poll or 0) then
                entry.poll=now+.25
