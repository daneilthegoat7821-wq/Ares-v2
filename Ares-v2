-- Bounded world discovery: original folder paths, no full-workspace scan.
app.bosses={Anton=true,Dozer=true,Whisper=true,Death=true,ScavKing=true,Scavking=true}
function app.first_part(obj)
    if obj:IsA("BasePart") then return obj end
    return obj:FindFirstChildWhichIsA("BasePart") or obj:FindFirstChild("HumanoidRootPart")
end
function app.scan()
    local ws=game.Workspace
    app.markers={}; app.npcs={}; app.boss_rows={}
    if not ws then return end
    local wants_npc=app.v("npc_on") or app.v("hud_boss") or (app.v("aim_on") and app.n("aim_pool")~=1)
    local ai=ws:FindFirstChild("AiZones")
    if ai and wants_npc then
        local budget=2000
        local function visit(obj,depth)
            if budget<=0 or depth>4 then return end
            budget=budget-1
            if obj.ClassName=="Model" then
                local hum=obj:FindFirstChildOfClass("Humanoid")
                local root=obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                if hum and root and hum.Health>0 and #app.npcs<256 then
                    local parts={}
                    for _,part in ipairs(obj:GetChildren()) do if part:IsA("BasePart") then parts[part.Name]=part end end
                    app.npcs[#app.npcs+1]={id="npc:"..tostring(obj.Address),name=obj.Name,char=obj,hum=hum,root=root,
                        parts=parts,npc=true,team=false,boss=app.bosses[obj.Name] or false}
                    return
                end
            end
            for _,child in ipairs(obj:GetChildren()) do visit(child,depth+1) end
        end
        visit(ai,0)
        for name in pairs(app.bosses) do
            if name~="Scavking" then
                local status="Not found"
                for _,n in ipairs(app.npcs) do if n.name:lower()==name:lower() then status=string.format("%d HP",n.hum.Health); break end end
                app.boss_rows[#app.boss_rows+1]={name,status}
            end
        end
        table.sort(app.boss_rows,function(aa,bb) return aa[1]<bb[1] end)
    end
    local nc=ws:FindFirstChild("NoCollision")
    local loot_spawns=nc and nc:FindFirstChild("LootSpawns")
    local sources={
        {kind="extracts",folder=nc and nc:FindFirstChild("ExitLocations")},
        {kind="extracts",folder=ws:FindFirstChild("Extracts")},
        {kind="extracts",folder=ws:FindFirstChild("ExitLocations")},
        {kind="items",folder=ws:FindFirstChild("DroppedItems")},
        {kind="items",folder=ws:FindFirstChild("RuntimeItems")},
        {kind="items",folder=ws:FindFirstChild("Drops")},
        {kind="containers",folder=ws:FindFirstChild("Containers")},
        {kind="containers",folder=ws:FindFirstChild("LootContainers")},
        {kind="containers",folder=loot_spawns and loot_spawns:FindFirstChild("Crates")},
        {kind="containers",folder=loot_spawns and loot_spawns:FindFirstChild("Open")},
        {kind="quests",folder=ws:FindFirstChild("QuestItems")},
        {kind="claymores",folder=ai and ai:FindFirstChild("Claymores")},
    }
    local seen={}
    for _,source in ipairs(sources) do
        local enabled=app.v("world_"..source.kind) or (source.kind=="items" and (app.v("world_corpses") or app.v("hud_loot")))
        if source.folder and enabled then
            local list=source.folder:GetChildren()
            local nested={}
            for i=1,math.min(#list,500) do
                local obj=list[i]
                if obj.ClassName=="Folder" then
                    local children=obj:GetChildren()
                    for j=1,math.min(#children,100) do
                        if #nested+#list>=500 then break end
                        nested[#nested+1]=children[j]
                    end
                end
            end
            for _,obj in ipairs(nested) do list[#list+1]=obj end
            for i=1,math.min(#list,500) do
                if #app.markers>=600 then break end
                local obj=list[i]; local part=app.first_part(obj)
                local id=tostring(obj.Address or obj)
                if part and not seen[id] then
                    seen[id]=true
                    local kind=source.kind
                    local hum=kind=="items" and obj:FindFirstChildOfClass("Humanoid")
                    if kind=="items" and (obj.Name:lower():find("corpse",1,true) or (hum and hum.Health<=0)) then kind="corpses" end
                    local entry={kind=kind,name=obj.Name,part=part,contents={}}
                    if (kind=="containers" or kind=="corpses") and app.v("world_contents") then
                        local inv=obj:FindFirstChild("Inventory") or obj:FindFirstChild("Items")
                        if inv then
                            local contents=app.item_inventory and app.item_inventory(inv) or inv:GetChildren()
                            for j=1,math.min(#contents,128) do
                                local name=type(contents[j])=="string" and contents[j] or contents[j].Name
                                if not app.item_passes_filter or app.item_passes_filter(name) then
                                    entry.contents[#entry.contents+1]=name
                                    if #entry.contents>=app.n("world_contents_limit") then break end
                                end
                            end
                        end
                    end
                    app.markers[#app.markers+1]=entry
                end
            end
        end
    end
end
