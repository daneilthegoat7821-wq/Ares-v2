    elseif s.failed>0 or s.pending>0 then s.status="Complete / value access errors"
    elseif equipped and s.held_numeric==0 then s.status="Complete / held recoil values not found"
    else s.status="Complete / recoil read back" end
    return s
end

-- Calibration restores all overrides and pauses frame servicing; clear the
-- traversal at the same boundary so resumption starts a fresh full generation.
if type(app.start_calibration)=="function" then
    local previous_calibration=app.start_calibration
    function app.start_calibration(reason)
        app.pd_weapon_cleanup("Calibration")
        return previous_calibration(reason)
    end
end

