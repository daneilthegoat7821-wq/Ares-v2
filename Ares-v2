local function mobility_number(value)
    return type(value)=="number" and value==value and value~=math.huge and value~=-math.huge
end
local function mobility_read(object,field)
    if not object then return nil end
    local ok,value=pcall(function() return object[field] end)
    if ok then return value end
end
local function mobility_owner(char)
    return char and tostring(mobility_read(char,"Address") or char) or nil
end
