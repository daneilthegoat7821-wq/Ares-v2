end
function app.solve_cursor(samples,source)
    if #samples<4 then return nil end
    local mx,my,tx,ty=0,0,0,0
    for _,sample in ipairs(samples) do
        local raw=sample.reads[source]
        if not raw or not app.finite(raw[1]) or not app.finite(raw[2]) then return nil end
        mx=mx+raw[1]; my=my+raw[2]; tx=tx+sample.target[1]; ty=ty+sample.target[2]
    end
    local n=#samples; mx=mx/n; my=my/n; tx=tx/n; ty=ty/n
    local sx,sy=0,0
    for _,sample in ipairs(samples) do
        sx=math.max(sx,math.abs(sample.reads[source][1]-mx)); sy=math.max(sy,math.abs(sample.reads[source][2]-my))
    end
    if sx<2 or sy<2 then return nil end
    local xx,xy,yy,ux,uy,vx,vy=0,0,0,0,0,0,0
    for _,sample in ipairs(samples) do
        local a=(sample.reads[source][1]-mx)/sx; local b=(sample.reads[source][2]-my)/sy
        local u=sample.target[1]-tx; local v=sample.target[2]-ty
        xx=xx+a*a; xy=xy+a*b; yy=yy+b*b
        ux=ux+a*u; uy=uy+b*u; vx=vx+a*v; vy=vy+b*v
    end
    local determinant=xx*yy-xy*xy
    if determinant<=0.0025*xx*yy then return nil end
    local a,b=(ux*yy-uy*xy)/determinant/sx,(uy*xx-ux*xy)/determinant/sy
    local d,e=(vx*yy-vy*xy)/determinant/sx,(vy*xx-vx*xy)/determinant/sy
    local model={x={a,b,tx-a*mx-b*my},y={d,e,ty-d*mx-e*my},source=source,rms=0,max_error=0,kind="affine"}
    local scale=math.sqrt((a*a+d*d)*(b*b+e*e))
    if not app.finite(scale) or scale<0.000001 or math.abs(a*e-b*d)<scale*0.01 then return nil end
    for _,coefficients in ipairs({model.x,model.y}) do
        for _,value in ipairs(coefficients) do if not app.finite(value) or math.abs(value)>1000000000 then return nil end end
    end
    for _,sample in ipairs(samples) do
        local x,y=app.map_cursor(model,sample.reads[source][1],sample.reads[source][2])
        local error_=math.sqrt((x-sample.target[1])^2+(y-sample.target[2])^2)
        model.rms=model.rms+error_*error_; model.max_error=math.max(model.max_error,error_)
    end
