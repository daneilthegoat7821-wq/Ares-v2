    end
    local function write_observation(now)
        observation.last_attempt=now;observation.report_error=nil
        local directory=tostring(app.profile_directory or "."):gsub("[\\/]+$","")
        if directory=="" then directory="." end
        local path=directory.."/weapon-diagnostics.txt"
        observation.report_path=path
        if type(app.profile_write)~="function" then observation.report_error="Profile writer unavailable"
        else
            local content=app.weapon_observation_text()
            local previous=weapon_report_read(path)
            if previous then
                -- Carry only the manual suffix, never an earlier automatic
                -- report. A new manual Capture replaces this file normally.
                local marker=previous:find(manual_suffix_marker,1,true)
                local manual=marker and previous:sub(marker+#manual_suffix_marker) or previous
                if manual:find("\nSchema: 1\n",1,true)
                    and manual:find("No supported table identity/write adapter or live behavior proof is available.\n",1,true) then
                    content=content..manual_suffix_marker..manual
                end
            end
            -- Leave the existing report untouched when preserving it would
            -- exceed the local helper's 48 KB UTF-8 file limit.
            if #content>47000 then observation.report_error="Automatic report with preserved manual capture exceeds 47000 bytes; existing file retained"
            else
                local ok,written,err=pcall(app.profile_write,path,content)
                if not ok or not written then observation.report_error=tostring(ok and err or written)
                else
                    local readback,read_error=weapon_report_read(path)
                    if readback~=content then observation.report_error=read_error or "Automatic report readback differs"
                    else
                        observation.report_verified=true;observation.last_file=now
                        observation.pending_file=false;observation.status="Automatic held observation saved / "..select(2,build_stamp())
                    end
                end
            end
        end
        if observation.report_error then observation.report_verified=false;observation.status="Automatic weapon report write failed" end
    end
    function app.weapon_observation_service(budget)
        budget=math.max(0,math.min(64,tonumber(budget) or 64))
        local configuration_key,active=configuration()
        if not active or not alive_and_ready() then return end
        local resolved=type(app.pd_observation_resolve)=="function" and app.pd_observation_resolve(budget) or 0
        observation.frame_visits=resolved
        budget=math.max(0,budget-resolved)
        local context=current_context()
        if not context or context_token(context,configuration_key)~=observation.token then
            observation.job=nil;observation.cycle=nil;observation.token=nil
            observation.report_verified=false
            observation.status="Held source changed; waiting for a fresh observation"
            return
        end
        local now=utility.GetTime()
        local job=observation.job
        if job then
            if job.token~=observation.token then observation.job=nil;return end
            local visits=app.pd_observation_step(job,budget)
            observation.frame_visits=observation.frame_visits+visits
            if job.done then
                observation.report_verified=false
                if (app.pd_weapon_status or {}).scanning then job.partial=true end
                if job.kind=="equip_or_configuration" then
                    observation.baseline=job;observation.baseline_pending=false;observation.pending_file=true
                elseif job.kind=="held_fire_input_audit" then
                    observation.audit=job;observation.pending_file=true
                else
                    local cycle=observation.cycle
                    if cycle and cycle.token==observation.token then
                        if job.kind=="before_fire_input" then cycle.before=job;cycle.stage="after_100ms"
                        elseif job.kind=="after_100ms" then cycle.after_100ms=job;cycle.stage="after_300ms"
                        else
                            cycle.after_300ms=job;cycle.stage="complete";observation.last_cycle_result=cycle
                            observation.cycle=nil;observation.baseline_pending=false;observation.pending_file=true
                        end
                    end
                end
                observation.job=nil
            end
        end
        local cycle_ready=not observation.cycle or observation.cycle.stage=="complete"
        if observation.pending_file and cycle_ready and app.maintenance_allowed and app.maintenance_allowed()
            and now-observation.last_attempt>=20 and now-app.recoil_evidence.last_action>=20 then
            write_observation(now)
        end
    end
    if type(app.pd_weapon_service)=="function" then
        local previous_service=app.pd_weapon_service
        function app.pd_weapon_service(force)
            app.weapon_observation_prepare(force)
            app.pd_observer_reserved=observation.job and 64 or 0
            local ok,result=pcall(previous_service,force)
            app.pd_observer_reserved=0
            if not ok then error(result) end
            local direct_visits=result and result.frame_visits or 0
            app.weapon_observation_service(math.min(64,math.max(0,128-direct_visits)))
            observation.combined_visits=direct_visits+observation.frame_visits
            return result
        end
    end
end

function app.recoil_diagnostics()
    local evidence=app.recoil_evidence
    local now=utility.GetTime()
    if now-evidence.last_action<3 then return false,"Wait three seconds between reports" end
    evidence.last_action=now; evidence.report_verified=false; evidence.last_error=nil
    local directory=tostring(app.profile_directory or "."):gsub("[\\/]+$","")
    local path=(directory~="" and directory or ".").."/weapon-diagnostics.txt"
    local lines={app.weapon_observation_text(),"Current captured recoil readback:"}
    local ok,readback=pcall(app.pd_weapon_readback)
    if ok and readback then
        lines[#lines+1]="captured="..weapon_report_value(readback.captured).." readable="..weapon_report_value(readback.readable)
            .." at_target="..weapon_report_value(readback.matches).." changed="..weapon_report_value(readback.changed)
        for _,sample in ipairs(readback.samples or {}) do
            lines[#lines+1]=weapon_report_value(sample.weapon).."/"..weapon_report_value(sample.pattern).."/"..weapon_report_value(sample.name)
                .." original="..weapon_report_value(sample.original).." target="..weapon_report_value(sample.target)
                .." current="..weapon_report_value(sample.current)
        end
    else lines[#lines+1]="Readback error: "..weapon_report_value(readback) end
    local text=table.concat(lines,"\n").."\n"
    evidence.report_path=path
    local written,err=app.profile_write(path,text)
    if written then
        local saved,read_error=weapon_report_read(path)
        if saved==text then evidence.report_verified=true else err=read_error or "Report readback differs" end
    end
    if not evidence.report_verified then evidence.last_error=err or "Report write failed" end
    app.toast(evidence.report_verified and "Recoil report saved and verified" or "Recoil report: "..tostring(evidence.last_error))
    return evidence.report_verified,evidence.report_verified and path or evidence.last_error
end
