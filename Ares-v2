-- horizontal gradient strip via vertical slices
local function grad_h(x,y,w,h,c1,c2,steps)
    steps = steps or 24
    local sw = w/steps
    for i=0,steps-1 do
        draw.RectFilled(x+i*sw, y, sw+1, h, mix(c1,c2,i/(steps-1)), 0)
    end
end

