end
-- Recoil-only held-value maintenance. Input
-- edges are evidence of fire input only, never proof that the game fired a gun.
do
    local manual_suffix_marker="\n===== PRESERVED MANUAL WEAPON REPORT / SCHEMA 1 =====\n"
    local observation={session=tostring(utility.GetTime())..":"..tostring(app),token=nil,
        last_lmb=false,last_attempt=-100,last_file=-100,last_audit=-100,last_cycle=-100,
        baseline_pending=false,pending_file=false,status="Waiting for active weapon controls",
        job=nil,cycle=nil,baseline=nil,audit=nil,frame_visits=0,combined_visits=0,
        report_verified=false,report_path=nil,report_error=nil,input_edges=0}
    app.weapon_observation=observation
    local function build_stamp()
        local product=Ares or DeltaNova or {}
        return tostring(product.Name or "A R E S V2"),tostring(product.Version or "2.1.0")
    end
    local function configuration()
        local parts={"recoil="..tostring(app.v("bs_no_recoil")==true),
            "reduction="..tostring(app.v("bs_recoil_reduction"))}
        local active=app.v("bs_no_recoil")==true
        table.sort(parts)
        return table.concat(parts,"|"),active
    end
    local function context_token(context,configuration_key)
        return tostring(context.id)..":"..tostring(context.equipped_id)..":"..tostring(context.owner)..":"..configuration_key
    end
    local function current_context()
        if type(app.pd_observation_context)~="function" then return nil end
        local context=app.pd_observation_context()
        if not context or not context.definition or not context.id then return nil end
        return context
    end
    local function alive_and_ready()
        return not app.stopped and app.me and app.me.IsAlive
            and (not app.cursor_ready or app.cursor_ready())
    end
    function app.weapon_observation_cancel(reason)
        observation.job=nil;observation.cycle=nil;observation.token=nil
        observation.baseline_pending=false;observation.pending_file=false
        observation.last_lmb=false;observation.report_verified=false;observation.status=reason or "Observation cancelled"
        app.pd_observer_reserved=0
    end
    local function start_job(kind,repair,now)
        if type(app.pd_observation_begin)~="function" then return false end
        local job=app.pd_observation_begin(observation.context,repair)
        if not job then return false end
        job.kind=kind;job.token=observation.token;job.input_time=observation.cycle and observation.cycle.started
        job.scheduled=now
        observation.job=job;observation.status="Observing held values / "..kind
