        app.panel("keys","KEYBINDS",rows,235)
    end
    if app.v("hud_boss") then app.panel("boss","BOSS TRACKER",app.boss_rows,245) end
    if app.v("hud_loot") then
        local items={}; local rows={}
        for _,marker in ipairs(app.markers) do
            if marker.kind=="items" and utility.IsValid(marker.part) and (not app.item_passes_filter or app.item_passes_filter(marker.name)) then
                items[#items+1]={name=marker.name,dist=app.distance(app.origin,marker.part.Position)*0.28}
            end
        end
        table.sort(items,function(aa,bb) return aa.dist<bb.dist end)
        for i=1,math.min(5,#items) do rows[#rows+1]={items[i].name,string.format("%dm",items[i].dist)} end
        app.panel("loot","NEARBY LOOT",rows,245)
    end
    if app.v("hud_damage") then
        local rows={}
        for i=#app.damage_feed,1,-1 do
            local event=app.damage_feed[i]
            rows[#rows+1]={event.name,"-"..math.floor(event.amount).." HP",theme.accent2}
        end
        app.panel("damage","OBSERVED DAMAGE",rows,245)
    end
    if app.v("damage_numbers") then
        for _,effect in ipairs(app.effects) do
            local age=now-effect.time; local p=effect.pos
            local sx,sy,on=draw.WorldToScreen(p.X,p.Y+3,p.Z)
            if on then app.center_text(sx,sy-age*35,"-"..math.floor(effect.amount),raw(theme.accent2,1-age),15) end
        end
    end
    app.radar()
    app.draw_velocity(now)
end

-- Stable render loop: input -> data -> behavior -> HUD -> menu.
function app.combat_tick() app.combat_service(app.telemetry_now) end
function app.finder_tick() app.finder_service(app.telemetry_now) end
function app.account_tick() app.account_service(app.telemetry_now) end
function app.combat_draw_tick() app.draw_combat(app.telemetry_now) end
function on_frame()
    local now=utility.GetTime()
    app.telemetry_now=now
    app.performance_frame(now)
    if app.stopped then app.draw_toasts(now); return end
    if app.loading_frame(now) then return end
    app.up_cooldown_service(now)
    app.ui_images_service()
    local sw,sh=draw.GetScreenSize()
    -- Prefer a roomy two-column layout, while keeping the menu on smaller displays.
    app.menu_size(sw,sh)
    local reads=app.read_cursor_sources(); app.raw_cursor=reads
    local down=input.IsKeyDown(0x01); local rdown=input.IsKeyDown(0x02)
    ui.mouse.clicked=down and not ui.mouse.was
    ui.mouse.rclicked=rdown and not ui.mouse.rwas; ui.mouse.down=down
    ui.mouse.was=down; ui.mouse.rwas=rdown
    if not down then ui.drag=nil end
    if app.edge(0x77) then app.start_calibration("F8 / align the cursor again.") end
    app.check_cursor(sw,sh,reads)
    if not app.cursor_ready() then
        local ok,err=pcall(app.calibration_frame,now,reads)
        if not ok then
            draw.RectFilled(1,1,sw-2,sh-2,{0.025,0.025,0.025,1},0)
            draw.Text(40,60,"A R E S V2 / press F8 to retry alignment",{0.94,0.94,0.94,1},20)
            draw.Text(40,100,tostring(err):sub(1,130),{0.65,0.65,0.65,1},13)
        end
        return
    end
    app.velocity_service(now)
    local mx,my=app.cursor_position(reads)
    ui.mouse.x,ui.mouse.y=mx,my
    if app.cursor.release_gate then
        ui.mouse.clicked=false; ui.mouse.rclicked=false
        if not down and not rdown then app.cursor.release_gate=false end
    end
    local capture_at_start=ui.capture~=nil
    local numeric_at_start=app.numeric_input()
    app.menu_keys(capture_at_start or numeric_at_start)
    if app.edge(0x2E) and not capture_at_start and not numeric_at_start and not ui.search_focus then app.disable() end
    if app.edge(0x1B) and not capture_at_start and not numeric_at_start then
        if ui.picker then ui.picker=nil elseif ui.popup then ui.popup=nil
        elseif ui.search_focus or ui.search~="" then ui.search=""; ui.search_focus=false
        else ui.open=false end
    end
    app.menu_drag(mx,my,sw,sh)
    if ui.open then
        app.guard("Key capture",capture)
        if not capture_at_start then app.guard("Search",app.search_input) end
        if not ui.picker then popup_input() end
    end
    theme.round=app.n("st_round"); theme.opacity=app.n("st_opac")/100
    theme.anim=app.v("ui_reduce_motion") and 100 or app.n("st_anim")/100
    theme.glow=app.n("st_glow")/100; theme.grad=app.v("th_grad")
    app.guard("Entity cache",app.sync)
    if app.errors["Entity cache"] and app.errors["Entity cache"].streak>0 then
        app.records={}; app.me=nil; app.origin=nil
    end
    if app.world_scan_job or now-app.last_scan>=app.n("scan_ms")/1000 then
        app.guard("World scan",app.scan); app.last_scan=now
    end
    app.guard("Keybinds",app.binds)
    app.guard("Boss alerts",app.boss_alert_service)
    app.guard("Aim",app.aim)
    app.guard("Combat feedback",app.combat_tick)
    app.guard("Cheater Finder",app.finder_tick)
    app.guard("Account profiles",app.account_tick)
    app.guard("Aim diagnostics",app.aim_diagnostic_service)
    if app.errors.Aim and app.errors.Aim.streak>0 then
        app.target=nil; app.guard("Silent cleanup",function() app.clear_silent(true) end)
    end
    app.guard("Movement",app.movement)
    app.guard("Movement diagnostics",app.movement_diagnostic_service)
    app.guard("World effects",app.world_fx)
    app.guard("PD recoil",app.pd_weapon_service)
    app.guard("Loadout data",app.loadout_service)
    app.guard("Image diagnostics",app.image_diagnostic_service)
    app.guard("Damage observer",app.damage_observer)
    app.guard("ESP",app.esp)
    app.guard("Hit-path labels",app.draw_hit_labels)
    app.guard("World overlay",app.world_esp)
    app.guard("Crosshair",draw_crosshair)
    app.guard("HUD",app.overlays)
    app.guard("Combat overlay",app.combat_draw_tick)
    app.guard("Live aim status",app.draw_aim_status)
    app.guard("Loadout HUD",app.loadout_draw)
    app.guard("Inventory HUD",app.inventory_draw)
    ui.appear=app.v("ui_reduce_motion") and (ui.open and 1 or 0) or approach("appear",ui.open and 1 or 0,16)
    if ui.appear>0.02 then
        local saved_opacity=theme.opacity; theme.opacity=theme.opacity*ui.appear
        app.hover=nil
        draw.RectFilled(ui.x-3,ui.y-3,ui.w+6,ui.h+6,a({0,0,0,1},0.35),theme.round+3)
        app.glow_outline(ui.x,ui.y,ui.w,ui.h,theme.round,theme.glow)
        draw.RectFilled(ui.x,ui.y,ui.w,ui.h,a(theme.base,1),theme.round)
        draw.Rect(ui.x,ui.y,ui.w,ui.h,a(mix(theme.line,theme.accent,theme.glow*0.55),1),theme.round,1)
        draw.Line(ui.x+theme.round,ui.y,ui.x+ui.w-theme.round,ui.y,a(theme.accent,0.35),1)
        if ui.open then app.guard("Interface",function() app.rail(now); app.content(now) end) end
        app.resize_handle()
        app.clamp_popup()
        if ui.picker then ui.picker.x=clamp(ui.picker.x,8,sw-PICK_W-8); ui.picker.y=clamp(ui.picker.y,8,sh-PICK_H-8) end
        app.guard("Dropdown",popup_draw); app.guard("Color picker",picker_draw_and_input)
        theme.opacity=saved_opacity
    end
    app.draw_toasts(now)
    app.draw_cursor()
end

