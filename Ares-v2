function app.finite(value)
    return type(value)=="number" and value==value and math.abs(value)<math.huge
end
function app.read_cursor_sources()
    local reads={}
    for _,source in ipairs({"client","absolute"}) do
        local fn
        if source=="client" then fn=input and input.GetMousePosition
        else fn=utility and utility.GetMousePos end
        if type(fn)=="function" then
            local ok,x,y=pcall(fn)
            if ok and app.finite(x) and app.finite(y) then reads[source]={x,y} end
        end
    end
    return reads
end
function app.map_cursor(model,x,y)
