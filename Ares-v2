            local age=now-C.marker.time
            if age>=0 and age<=C.marker.life then
                local fade=1-age/C.marker.life;local cx,cy=crosshair()
                local size=numeric("cb_marker_size",7,4,20);local c=ui.colors._hitmarker or theme.text
                for _,sign in ipairs({{-1,-1},{1,-1},{-1,1},{1,1}}) do
                    local x,y=cx+sign[1]*3,cy+sign[2]*3
                    local ex,ey=cx+sign[1]*(size+3),cy+sign[2]*(size+3)
                    draw.Line(x,y,ex,ey,raw(c,fade*.12),4)
